+// =====================================================================
+//  MD3 wizard data tables
+//  Presentation only: retain Horizon's DOM, actions, selection state,
+//  workflow behavior and the existing MyCloud color system.
+// =====================================================================
+
+// Angular wizard transfer tables (Source, Flavor, Networks, Ports, Security
+// Groups, Key Pairs and Server Groups) share the same outlined data-table
+// rhythm. The existing wrappers continue to own scrolling and allocation.
+.ng-wizard .transfer-table {
+  .transfer-section {
+    margin-top: 16px;
+  }
+
+  .transfer-heading {
+    display: flex;
+    align-items: center;
+    gap: 8px;
+    min-height: 40px;
+    margin: 0 0 8px;
+    font-size: 16px;
+    line-height: 24px;
+    font-weight: 600;
+
+    .fa {
+      flex: 0 0 auto;
+      margin-right: 0;
+    }
+
+    .help-text {
+      margin: 0 0 0 auto;
+      font-size: 12px;
+      line-height: 16px;
+      font-weight: 500;
+    }
+  }
+
+  .transfer-available,
+  .transfer-allocated {
+    border: 1px solid $mc-border;
+    border-radius: 12px;
+    box-sizing: border-box;
+  }
+
+  hz-dynamic-table,
+  .hz-magic-search-context {
+    display: block;
+    min-width: 100%;
+  }
+
+  .hz-dynamic-table-preamble {
+    min-height: 56px;
+    margin: 0;
+    padding: 8px 12px;
+    border-bottom: 1px solid $mc-border;
+    align-items: center;
+    box-sizing: border-box;
+  }
+
+  // Allocated tables often have neither search nor batch actions. Horizon
+  // still renders the preamble container, so do not turn that empty shell
+  // into a visual row. Comment nodes left by Angular ng-if are ignored by
+  // :has(), making this reliable without changing the widget template.
+  .hz-dynamic-table-preamble:not(:has(.hz-magic-search-bar)):not(:has(.hz-dynamic-table-actions)) {
+    display: none;
+  }
+
+  .magic-search-bar,
+  .basic-search-bar,
+  .hz-magic-search-bar {
+    margin-top: 0;
+    margin-bottom: 0;
+  }
+
+  .table {
+    width: 100%;
+    margin: 0;
+    border: 0;
+    border-collapse: separate;
+    border-spacing: 0;
+  }
+
+  .table > thead > tr:first-child > td {
+    height: 40px;
+    padding: 8px 16px;
+    border-bottom: 1px solid $mc-border;
+    vertical-align: middle;
+  }
+
+  .table > thead > tr:last-child > th {
+    height: 48px;
+    padding: 8px 16px;
+    border-bottom: 1px solid $mc-border;
+    font-size: 12px;
+    line-height: 16px;
+    font-weight: 600;
+    vertical-align: middle;
+  }
+
+  .table > tbody > tr > td {
+    height: 52px;
+    padding: 8px 16px;
+    border-bottom: 1px solid $mc-border;
+    font-size: 14px;
+    line-height: 20px;
+    vertical-align: middle;
+  }
+
+  .table > tbody > tr:last-child > td {
+    border-bottom: 0;
+  }
+
+  .table > tbody > tr.detail-row > td {
+    height: auto;
+    padding: 12px 16px;
+  }
+
+  .table > tfoot > tr > td {
+    height: 48px;
+    padding: 8px 16px;
+    border-top: 1px solid $mc-border;
+    border-bottom: 0;
+    vertical-align: middle;
+  }
+
+  .table .multi_select_column {
+    width: 48px;
+    min-width: 48px;
+    text-align: center;
+  }
+
+  .table .actions_column {
+    width: 52px;
+    min-width: 52px;
+    text-align: center;
+  }
+
+  .table .no-rows-help,
+  .table tr[hz-no-items] > td {
+    height: 64px;
+    padding: 16px;
+    text-align: center;
+    vertical-align: middle;
+  }
+
+  // Expanded security-group rules are a compact MD3 table nested inside the
+  // parent row; keep their hierarchy distinct without changing expansion.
+  .security-group-details {
+    margin: 4px 0;
+    border: 1px solid $mc-border;
+    border-radius: 8px;
+    border-collapse: separate;
+    border-spacing: 0;
+
+    > thead > tr > th,
+    > tbody > tr > td {
+      height: 40px;
+      padding: 8px 12px;
+      vertical-align: middle;
+    }
+
+    > tbody > tr:last-child > td {
+      border-bottom: 0;
+    }
+  }
+}
+
+// Django workflow tables use the same outline, row rhythm and type roles.
+// This covers Resize Instance's Flavor Details and future real tables placed
+// in a classic Horizon wizard without affecting tables outside workflows.
+.workflow.wizard .table {
+  width: 100%;
+  margin: 0 0 16px;
+  border: 1px solid $mc-border;
+  border-radius: 12px;
+  border-collapse: separate;
+  border-spacing: 0;
+
+  > thead > tr > th {
+    height: 48px;
+    padding: 8px 16px;
+    border-left: 0;
+    border-right: 0;
+    border-bottom: 1px solid $mc-border;
+    font-size: 12px;
+    line-height: 16px;
+    font-weight: 600;
+    vertical-align: middle;
+  }
+
+  > tbody > tr > th,
+  > tbody > tr > td {
+    height: 52px;
+    padding: 8px 16px;
+    border-left: 0;
+    border-right: 0;
+    border-bottom: 1px solid $mc-border;
+    font-size: 14px;
+    line-height: 20px;
+    vertical-align: middle;
+  }
+
+  > tbody > tr:last-child > th,
+  > tbody > tr:last-child > td {
+    border-bottom: 0;
+  }
+}
+
+.workflow.wizard .flavor_table .flavor_name {
+  width: 44%;
+  font-weight: 600;
+}
+
+// Membership is Horizon's Django "fake table". It already has MD3 outlined
+// rows above; these rules align both column headers and filters to that grid.
+.workflow.wizard .membership > .header > .row,
+.workflow.wizard .membership > .row {
+  margin-right: -8px;
+  margin-left: -8px;
+}
+
+.workflow.wizard .membership > .header > .row > [class*="col-"],
+.workflow.wizard .membership > .row > [class*="col-"] {
+  padding-right: 8px;
+  padding-left: 8px;
+}
+
+.workflow.wizard .membership .members_title {
+  display: flex;
+  align-items: center;
+  min-height: 40px;
+  padding: 0;
+  font-size: 14px;
+  line-height: 20px;
+  font-weight: 600;
+}
+
+.workflow.wizard .membership .role_options > .btn {
+  min-height: 40px;
+  padding-top: 8px;
+  padding-bottom: 8px;
+}
+
+@media (max-width: 767px) {
+  .ng-wizard .transfer-table {
+    .transfer-heading {
+      flex-wrap: wrap;
+
+      .help-text {
+        flex: 1 0 100%;
+        margin-left: 24px;
+      }
+    }
+
+    .table > thead > tr:first-child > td,
+    .table > thead > tr:last-child > th,
+    .table > tbody > tr > td,
+    .table > tfoot > tr > td {
+      padding-right: 12px;
+      padding-left: 12px;
+    }
+  }
+
+  .workflow.wizard .table > thead > tr > th,
+  .workflow.wizard .table > tbody > tr > th,
+  .workflow.wizard .table > tbody > tr > td {
+    padding-right: 12px;
+    padding-left: 12px;
+  }
+}
+
+// =====================================================================
+//  Responsive  (≤ 991px: tablet + mobile)
+// =====================================================================
+// P1 — Off-canvas sidebar. On desktop the 265px sidebar is fixed and the
+// navbar/content are inset by that width. Below the md breakpoint we slide the
+// sidebar off-canvas and give the navbar + content the full width. Horizon's
+// own hamburger (#sidebar-toggle) + horizon.sidebar.js already toggle the
+// `.on-screen` class on #sidebar and the #sidebar-mask backdrop — the theme had
+// pinned the sidebar on-screen and hidden the toggle, so this restores it.
+@media (max-width: 991px) {
+  #sidebar {
+    left: -$sidebar-width !important;
+    transition: left .25s ease;
+  }
+
+  #sidebar.on-screen {
+    left: 0 !important;
+  }
+
+  // Backdrop behind the open drawer (created by horizon.sidebar.js). Core only
+  // reveals it ≤ 767px; extend that to the same breakpoint and sit it just
+  // under the sidebar.
+  #sidebar-mask {
+    z-index: 1034;
+  }
+
+  #sidebar-mask.on-screen {
+    visibility: visible;
+    opacity: 1;
+  }
+
+  .navbar.navbar-default.navbar-fixed-top {
+    left: 0;
+    width: 100%;
+  }
+
+  // The navbar is a flex row of .navbar-header (holds the toggles/brand) +
+  // .navbar-collapse (pills + user). Make both clean centered cells clamped to
+  // the navbar height so nothing floats out of the 60px bar.
+  .navbar.navbar-default.navbar-fixed-top .navbar-header {
+    display: flex;
+    align-items: center;
+    float: none;
+    height: $navbar-height;
+    margin: 0;
+    padding: 0;
+    flex: 0 0 auto;
+  }
+
+  .navbar.navbar-default.navbar-fixed-top .navbar-collapse {
+    height: $navbar-height;
+    margin: 0;
+    flex: 1 1 auto;
+    min-width: 0;
+  }
+
+  // Only one hamburger: hide the brand and Bootstrap's second (navbar-collapse)
+  // toggle; keep #sidebar-toggle.
+  .navbar.navbar-default.navbar-fixed-top .navbar-brand,
+  .navbar.navbar-default.navbar-fixed-top .navbar-toggle.collapsed {
+    display: none !important;
+  }
+
+  // Restore Horizon's hamburger (the theme hides it on desktop) as a clean,
+  // non-floated flex button.
+  .navbar.navbar-default.navbar-fixed-top #sidebar-toggle {
+    display: inline-flex;
+    flex-direction: column;
+    align-items: center;
+    justify-content: center;
+    float: none !important;
+    width: 40px;
+    height: 40px;
+    margin: 0 8px 0 0;
+    padding: 0;
+    border: 1px solid $mc-border;
+    border-radius: 10px;
+    background: #fff;
+    flex: 0 0 auto;
+  }
+
+  .navbar.navbar-default.navbar-fixed-top #sidebar-toggle .icon-bar {
+    display: block;
+    width: 18px;
+    height: 2px;
+    border-radius: 2px;
+    background: #334155;
+  }
+
+  .navbar.navbar-default.navbar-fixed-top #sidebar-toggle .icon-bar + .icon-bar {
+    margin-top: 4px;
+  }
+
+  #content_body {
+    padding-left: 0 !important;
+  }
+
+  // P2 — wide list tables scroll horizontally inside their own card instead of
+  // pushing the whole page wider than the viewport. Django tables card the
+  // .table_wrapper; Angular tables (Images, …) put the card on the table itself
+  // inside .hz-magic-search-context, so scroll that container.
+  #content_body .table_wrapper,
+  #content_body .table-responsive {
+    overflow-x: auto;
+  }
+
+  // Angular tables keep `overflow: visible` (for row dropdowns) at desktop; on
+  // small screens the wide table would push the page, so scroll it instead.
+  // `!important` beats the higher-specificity desktop rule.
+  #content_body hz-resource-table .hz-magic-search-context,
+  #content_body .hz-magic-search-context {
+    overflow-x: auto !important;
+  }
+
+  // P3 — topbar pills fit the narrower navbar: tighter padding/gaps and a
+  // truncated project label so the row never overflows.
+  .navbar.navbar-default.navbar-fixed-top .container-fluid {
+    padding: 0 12px;
+  }
+
+  .navbar.navbar-default.navbar-fixed-top .mc-topbar-pills {
+    gap: 6px;
+    min-width: 0;
+  }
+
+  .mc-ctx-pill .context-overview {
+    max-width: 120px;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+  }
+
+  // Bootstrap turns navbar dropdowns into static/transparent inline menus on
+  // mobile; the topbar keeps its horizontal pill layout, so restore proper popup
+  // menus for the project-context and user dropdowns.
+  .navbar.navbar-default.navbar-fixed-top .navbar-nav .open > .dropdown-menu {
+    position: absolute !important;
+    float: none;
+    width: auto;
+    margin-top: 4px;
+    background-color: #fff !important;
+    border: 1px solid $mc-border !important;
+    border-radius: 12px !important;
+    box-shadow: $mc-shadow !important;
+  }
+
+  .navbar.navbar-default.navbar-fixed-top .navbar-nav .open > .dropdown-menu > li > a {
+    padding: 8px 14px;
+  }
+}
+
+// P3 — on the narrowest screens hide only the user-name label (the avatar stays
+// clickable) so the project switcher + region pill + user menu keep breathing
+// room. `!important` beats the theme's `> li { display: flex }`.
+@media (max-width: 600px) {
+  .navbar.navbar-default.navbar-fixed-top .user-menu .user-name {
+    display: none !important;
+  }
+}
