+// ============================================================================
+//  MD3 TABLES — one shared look across every Horizon table: Django
+//  (.table_wrapper table) and Angular (table.table-rsp). CSS-only: no column,
+//  DOM or workflow change. Adds the Material-3 signals the theme doesn't already
+//  have — comfortable density, low-emphasis dividers, primary state-layer hover
+//  + selected, accent checkbox. (Rounded card, tonal header, status pills and
+//  the MD3 empty state already exist above.)
+// ============================================================================
+#content_body .table_wrapper table > tbody > tr > td,
+#content_body table.table-rsp > tbody > tr > td {
+  padding-top: 14px;
+  padding-bottom: 14px;
+  border-bottom: 1px solid #eef2f7;      // low-emphasis divider (outline-variant)
+  transition: background-color .12s ease;
+}
+// MD3 state layer: hover washes the row with a faint primary tint, not grey.
+#content_body .table_wrapper table > tbody > tr:hover > td,
+#content_body table.table-rsp > tbody > tr:hover > td {
+  background-color: rgba(37, 99, 235, .06) !important;
+}
+// MD3 selected container: a checked (or Angular .st-selected) row tints primary.
+#content_body .table_wrapper table > tbody > tr:has(td.multi_select_column input:checked) > td,
+#content_body table.table-rsp > tbody > tr:has(td.multi_select_column input:checked) > td,
+#content_body table.table-rsp > tbody > tr.st-selected > td {
+  background-color: rgba(37, 99, 235, .10) !important;
+}
+// Primary-accent selection checkbox.
+#content_body .table_wrapper table .multi_select_column input[type="checkbox"],
+#content_body table.table-rsp .multi_select_column input[type="checkbox"] {
+  accent-color: #2563eb;
+}
+// While a row's action menu is open the pointer still sits on that row, so the
+// hover state layer would leave it a different colour from the rest. Keep every
+// row one uniform colour whenever an action dropdown is open.
+#content_body .table_wrapper table > tbody > tr:has(td.actions_column .btn-group.open) > td,
+#content_body table.table-rsp > tbody > tr:has(td.actions_column .btn-group.open) > td {
+  background-color: #fff !important;
+}
+// The empty "No items" row is its own MD3 state (icon + message) — no divider.
+#content_body .table_wrapper table:has(tbody tr.empty) > tbody > tr.empty > td,
+#content_body table:has(td.no-rows-help) > tbody > tr > td.no-rows-help {
+  border-bottom: 0;
+}
