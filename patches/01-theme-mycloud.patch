+  justify-content: flex-end;
+  float: none;
+  border-radius: 0;
+
+  &::before,
+  &::after { content: none; display: none; }
+
+  // segmented "Instance ID = | input | Filter" facet
+  .table_search,
+  .table_filter {
+    display: inline-flex;
+    align-items: center;
+    gap: 8px;
+    float: none;
+    margin: 0;
+  }
