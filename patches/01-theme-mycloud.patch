+
+// NOTE: do NOT force flex/max-height/overflow on .ng-wizard or its
+// .modal-body — the Angular Launch Instance wizard measures element heights
+// (magic-search / transfer tables), and overriding them triggers a reflow
+// loop that lags or freezes the UI. Leave the wizard layout to Angular.
+//
+// Stable wizard size: fix the body height so the modal does not resize as
+// the user moves between steps (Details is short, Source/Flavor are tall);
+// taller steps scroll internally. The wizard/transfer-table/magic-search
+// widgets don't read element heights in JS, so this pure-CSS height is
+// one-pass and cannot reintroduce the reflow lag.
+.ng-wizard .modal-body {
+  height: calc(100vh - 19rem);
+  overflow-y: auto;
+  overflow-x: hidden;
+}
+
+// Long "Available"/"Allocated" lists scroll inside their own box so the
+// rest of the step (description, Allocated heading) stays fixed.
+.modal .transfer-available,
+.modal .transfer-allocated {
+  max-height: 36vh;
+  overflow-y: auto;
+  // was hidden — let the row scroll so the allocate (up) button is reachable
+  // on narrow modals instead of being clipped off-screen
+  overflow-x: auto;
+}
+// Tighter cells so the flavor/source table fits the modal more often (the
+// allocate button is the last column and was overflowing off-screen).
+.modal .transfer-table .table > tbody > tr > td,
+.modal .transfer-table .table > thead > tr > th { padding: 8px 10px; }
+
+// Keep the transfer search/filter row in the normal table flow. Sticky here
+// makes the helper text and search field look detached on short lists.
+.modal .transfer-available .hz-magic-search-context > .row {
+  position: static;
+  margin-left: 0;
+  margin-right: 0;
+  padding-bottom: 0;
+}
+
+// =====================================================================
+//  Layout — sidebar full-height, navbar confined to right column
+// =====================================================================
+
+// Sidebar: pin to top-left corner, span full viewport height
+#sidebar {
+  top: 0 !important;
+  left: 0 !important;
+  bottom: 0;
+  height: 100vh;
+  overflow-y: auto;
+  overflow-x: hidden;
+  z-index: 1035; // above Bootstrap navbar (z-index 1030)
+
+  &::-webkit-scrollbar { width: 6px; }
+  &::-webkit-scrollbar-thumb { background: #334155; border-radius: 6px; }
+}
+
+// Brand block at top of sidebar
+.mc-sidebar-brand {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 18px 20px;
+  font-weight: 700;
+  font-size: 16px;
+  color: #fff;
+  position: sticky;
+  top: 0;
+  background: $mc-side-bg;
+  z-index: 2;
+  border-bottom: 0;
+  text-decoration: none;
+
+  &:hover { text-decoration: none; color: #fff; }
+}
+
+.mc-brand-logo {
+  width: 30px;
+  height: 30px;
+  border-radius: 8px;
+  background: linear-gradient(135deg, $brand-primary, lighten($brand-primary, 10%));
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  font-size: 16px;
+  flex-shrink: 0;
+
+  .fa {
+    color: #fff;
+    font-size: 14px;
+  }
+
+  svg {
+    width: 18px;
+    height: 18px;
+    display: block;
+    fill: #fff;
+  }
+}
+
+// Navbar: push left edge to sidebar width, proper flex alignment matching demo
+.navbar.navbar-default.navbar-fixed-top {
+  left: $sidebar-width;
+  right: 0;
+  width: auto;
+  min-height: $navbar-height;
+
+  .navbar-brand { display: none; }
+  #sidebar-toggle { display: none; }
+
+  // Turn container into a true flex row — pills left, user right, vertically centered
+  .container-fluid {
+    display: flex;
+    align-items: center;
+    height: $navbar-height;
+    padding: 0 24px;
+  }
+
+  // Collapse wrapper: flex row, stretch full width
+  .navbar-collapse {
+    display: flex !important;
+    align-items: center;
+    width: 100%;
+    padding: 0;
+    border: 0;
+    box-shadow: none;
+  }
+
+  // Left pill group
+  .mc-topbar-pills.navbar-nav {
+    display: flex !important;
+    align-items: center;
+    float: none;
+    margin: 0;
+    padding: 0;
+    gap: 8px;
+    flex-shrink: 0;
+
+    > li {
+      display: flex !important;
+      align-items: center;
+      float: none;
+    }
+  }
+
+  // Right user group — push to far right
+  .mc-topbar-right.navbar-nav {
+    display: flex !important;
+    align-items: center;
+    float: none;
+    margin-left: auto;
+    padding: 0;
+    gap: 4px;
+
+    > li {
+      display: flex !important;
+      align-items: center;
+      float: none;
+    }
+  }
+}
+
+// #content_body already has padding-left: $sidebar-width via _layout.scss
+// Do NOT add it to #main_content — that pushes the fixed sidebar off-screen
+
+// Content area padding to match design .content{padding:var(--content-pad-y) var(--content-pad-x) 42px}
+#content_body > .container-fluid {
+  padding-left: 0;
+  padding-right: 0;
+}
+
+#content_body > .container-fluid > .row {
+  margin-left: 0;
+  margin-right: 0;
+}
+
+#content_body > .container-fluid > .row > .col-xs-12 {
+  padding-top: $mc-content-pad-y;
+  padding-left: $mc-content-pad-x;
+  padding-right: $mc-content-pad-x;
+  padding-bottom: 42px;
+}
+
+@media (max-width: 800px) {
+  #content_body > .container-fluid > .row > .col-xs-12 {
+    padding: 18px 18px 42px;
+  }
+}
+
+@media (max-width: 520px) {
+  #content_body > .container-fluid > .row > .col-xs-12 {
+    padding: 14px 12px 34px;
+  }
+}
+
+// Empty breadcrumb wrapper should not take up space
+.page-breadcrumb:empty {
+  display: none;
+}
+
+// User avatar: circle with initials
+.mc-user-avatar {
+  width: 34px;
+  height: 34px;
+  border-radius: 50%;
+  background: linear-gradient(135deg, $brand-primary, lighten($brand-primary, 12%));
+  color: #fff;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  font-weight: 700;
+  font-size: 13px;
+  flex-shrink: 0;
+  vertical-align: middle;
+}
+
+// User menu link — replace fa-user icon with avatar
+.user-menu > a {
+  display: flex !important;
+  align-items: center;
+  gap: 8px;
+}
+
+// Context selectors (project / region) — pill style
+.navbar-nav > li.context-selection > a,
+#context_selection > li > a,
+.context-selection > li > a {
+  display: inline-flex !important;
+  align-items: center;
+  gap: 6px;
+  background: $body-bg !important;
+  border: 1px solid $mc-border !important;
+  border-radius: 8px !important;
+  padding: 6px 14px !important;
+  margin: 11px 4px !important;
+  font-weight: 500;
+  line-height: 1.4;
+}
+
+// =====================================================================
+//  Overview page — header, activity panel, usage table
+// =====================================================================
+
+// Page head: title + subtitle on left, action buttons on right
+.mc-page-head {
+  display: flex;
+  align-items: flex-end;
+  justify-content: space-between;
+  gap: 16px;
+  flex-wrap: wrap;
+  margin-bottom: $mc-section-gap;
+  padding: 0;
+  border-bottom: 0;
+}
+
+.mc-page-title {
+  font-size: 22px;
+  font-weight: 700;
+  margin: 0;
+  color: $text-color;
+}
+
+.mc-page-crumb {
+  color: #94a3b8;
+  font-size: 14px;
+  line-height: 1.4;
+  margin-bottom: 8px;
+
+  strong { color: inherit; font-weight: 400; }
+}
+
+.mc-page-sub {
+  color: #64748b;
+  font-size: 14px;
+  margin: 0;
+}
+
+.mc-page-actions {
+  display: flex;
+  gap: 10px;
+  flex-shrink: 0;
+}
+
+.mc-launch-btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 7px;
+  padding: 9px 14px;
+  border: 0;
+  border-radius: 8px;
+  font-size: 14px;
+  font-weight: 600;
+  line-height: 1.4;
+  box-shadow: $mc-shadow-sm;
+}
+
+// Inline SVG icon inside buttons (e.g. + Launch Instance)
+.mc-btn-ic {
+  width: 14px;
+  height: 14px;
+  min-width: 14px;
+  max-width: 14px;
+  min-height: 14px;
+  max-height: 14px;
+  flex: 0 0 14px;
+}
+
+.mc-btn-ghost {
+  background: $mc-surface;
+  border-color: $mc-border;
+  color: $text-color;
+  height: 36px;
+  min-height: 36px;
+  &:hover { background: $body-bg; }
+}
+
+// Recent activity summary panel (replaces raw _usage_summary)
+.mc-recent-panel {
+  background: $mc-surface;
+  border: 1px solid $mc-border;
+  border-radius: 12px;
+  box-shadow: $mc-shadow;
+  overflow: hidden;
+  margin-bottom: $mc-section-gap;
+}
+
+.mc-recent-head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  flex-wrap: wrap;
+  gap: 12px;
+  padding: 14px 20px;
+  border-bottom: 1px solid $mc-border;
+}
+
+.mc-recent-title {
+  font-size: 16px;
+  font-weight: 700;
+  margin: 0;
+  color: $text-color;
+}
+
+// Compact date range form in panel header
+.mc-date-form {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  margin: 0;
+
+  input[type="text"] {
+    height: 32px;
+    padding: 4px 14px;
+    font-size: 13px;
+    border: 1px solid $mc-border;
+    border-radius: 7px;
+    width: 100px;
+  }
+
+  .btn { height: 32px; padding: 4px 14px; font-size: 13px; }
+}
+
+.mc-activity-dl {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
+  gap: 0;
+  margin: 0;
+}
+
+.mc-activity-row {
+  padding: 12px 20px;
+  border-right: 1px solid $mc-border;
+  &:last-child { border-right: none; }
+
+  dt {
+    font-size: 11px;
+    font-weight: 700;
+    text-transform: uppercase;
+    letter-spacing: .5px;
+    color: #94a3b8;
+    margin-bottom: 4px;
+  }
+
+  dd {
+    font-size: 20px;
+    font-weight: 700;
+    color: $text-color;
+    margin: 0;
+  }
+}
+
+// Usage (instances) table wrapper
+.mc-usage-table {
+  background: $mc-surface;
+  border: 1px solid $mc-border;
+  border-radius: 12px;
+  box-shadow: $mc-shadow;
+  overflow: hidden;
+  margin-bottom: $mc-section-gap;
+
+  .mc-usage-table-head {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 12px;
+    padding: 14px 18px;
+    border-bottom: 1px solid $mc-border;
+  }
+
+  .mc-usage-table-title {
+    font-size: 16px;
+    font-weight: 700;
+    color: $text-color;
+  }
+
+  // Flatten the inner horizon table wrapper
+  .table_wrapper,
+  .table-responsive {
+    border-radius: 0;
+    box-shadow: none;
+    border: none;
+    margin-bottom: 0;
+  }
+  .table_actions, .table-striped thead { border-radius: 0; }
+
+  // Keep table-level action buttons aligned to the right.
+  .table-actions-btn-group { margin-left: auto; }
+
+  // DataTable renders its own "Usage" caption — hide it since we have mc-usage-table-title
+  .quota-heading { display: none; }
+  caption { display: none; }
+}
+
+// =====================================================================
+//  4-stat key metrics row (Overview top — matches demo)
+// =====================================================================
+.mc-key-stats {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
+  gap: 16px;
+  margin-bottom: $mc-section-gap;
+  overflow: visible;
+
+  .mc-stat--key {
+    background: $mc-surface;
+    border: 1px solid $mc-border;
+    border-radius: 12px;
+    box-shadow: $mc-shadow;
+    min-height: 148px;
+    padding: 16px 18px;
+    display: flex;
+    flex-direction: column;
+    transition: none;
+    animation: none;
+    transform: none;
+
+    &:hover,
+    &:focus,
+    &:active {
+      border-color: $mc-border;
+      box-shadow: $mc-shadow;
+      transform: none;
+    }
+
+    .mc-stat-top {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+    }
+
+    .mc-stat-ic {
+      width: 42px;
+      height: 42px;
+      border-radius: 12px;
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      font-size: 18px;
+      flex-shrink: 0;
+
+      svg { width: 22px; height: 22px; }
+
+      &.mc-ic-1 { background: #dbeafe; color: #2563eb; }
+      &.mc-ic-2 { background: #ccfbf1; color: #0d9488; }
+      &.mc-ic-3 { background: #ede9fe; color: #7c3aed; }
+      &.mc-ic-4 { background: #fef3c7; color: #d97706; }
+    }
+
+    .mc-stat-num small { font-size: 14px; font-weight: 600; color: #64748b; }
+
+    .mc-trend {
+      display: inline-flex;
+      align-items: center;
+      min-height: 24px;
+      font-size: 12px;
+      font-weight: 700;
+      padding: 3px 10px;
+      border-radius: 20px;
+      background: #f1f5f9;
+      color: #64748b;
+      white-space: nowrap;
+
+      &.is-ok     { background: #dcfce7; color: #16a34a; }
+      &.is-warn   { background: #fef3c7; color: #d97706; }
+      &.is-danger { background: #fee2e2; color: #dc2626; }
+      &.mc-trend--nolimit { background: #f1f5f9; color: #94a3b8; }
+    }
+
+    .mc-stat-num {
+      font-size: 28px;
+      font-weight: 700;
+      line-height: 1;
+      color: $text-color;
+      margin-top: 20px;
+    }
+
+    .mc-stat-label {
+      font-size: 14px;
+      font-weight: 600;
+      line-height: 1.35;
+      color: #64748b;
+      margin-top: 8px;
+      white-space: nowrap;
+      overflow: hidden;
+      text-overflow: ellipsis;
+    }
+  }
+}
