+}
+
+// One MD3 desktop gutter across the toolbar, counts, header, rows and footer.
+body.mc-project-instances-page #instances > caption,
+body.mc-project-instances-page #instances > thead > tr > td,
+body.mc-project-instances-page #instances > tfoot > tr > td {
