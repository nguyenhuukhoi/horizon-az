+// The project/admin Instances table has more columns than most Horizon tables.
+// Give content-heavy fields room first and keep compact/status columns stable.
+// Keep the image data in Horizon, but omit Image Name from the MyCloud project
+// table. Admin Instances and other themes retain their original columns.
+body.mc-project-instances-page #instances th:nth-child(3),
+body.mc-project-instances-page #instances td:nth-child(3) {
