+  .table_search.client .form-control { padding-right: 14px; }
+
+  // every button in the row → consistent height/shape
+  .btn,
+  .table_search .btn,
+  .table_actions_menu > .btn {
+    height: 36px;
+    padding: 0 14px;
+    border-radius: 8px;
+    display: inline-flex;
+    align-items: center;
+    gap: 7px;
+    white-space: nowrap;
