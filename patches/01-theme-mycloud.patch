diff --git a/openstack_dashboard/themes/mycloud/templates/admin/hypervisors/index.html b/openstack_dashboard/themes/mycloud/templates/admin/hypervisors/index.html
new file mode 100644
index 000000000..6e985846e
--- /dev/null
+++ b/openstack_dashboard/themes/mycloud/templates/admin/hypervisors/index.html
@@ -0,0 +1,118 @@
+{% extends 'base.html' %}
+{% load i18n horizon humanize sizeformat %}
+
+{% block title %}{% trans "Hypervisors" %}{% endblock %}
+
+{% block breadcrumb_nav %}{% endblock %}
+
+{% block page_header %}
+  <div class="mc-page-crumb"><strong>{% trans "Admin" %}</strong> / {% trans "Compute" %} / {% trans "Hypervisors" %}</div>
+  <div class="mc-page-head mc-hv-page-head">
+    <div>
+      <h1 class="mc-page-title">{% trans "Hypervisors" %}</h1>
+    </div>
+  </div>
+{% endblock %}
+
+{% block main %}
+  {% widthratio stats.vcpus_used stats.vcpus 100 as vcpu_pct %}
+  {% widthratio stats.memory_mb_used stats.memory_mb 100 as ram_pct %}
+  <div class="quota-dynamic mc-key-stats mc-hv-stats">
+    <div class="mc-stat-grid">
+      <div class="mc-stat mc-stat--key">
+        <div class="mc-stat-top">
+          <span class="mc-stat-ic mc-ic-1"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"/> <rect width="20" height="8" x="2" y="14" rx="2" ry="2"/> <line x1="6" x2="6.01" y1="6" y2="6"/> <line x1="6" x2="6.01" y1="18" y2="18"/></svg></span>
+          <span class="mc-trend is-ok">{{ stats.count|default:0|intcomma }} {% trans "hosts" %}</span>
+        </div>
+        <div class="mc-stat-num">{{ stats.count|default:0|intcomma }}</div>
+        <div class="mc-stat-label">{% trans "Hypervisors" %}</div>
+      </div>
+      <div class="mc-stat mc-stat--key">
+        <div class="mc-stat-top">
+          <span class="mc-stat-ic mc-ic-2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20v2"/> <path d="M12 2v2"/> <path d="M17 20v2"/> <path d="M17 2v2"/> <path d="M2 12h2"/> <path d="M2 17h2"/> <path d="M2 7h2"/> <path d="M20 12h2"/> <path d="M20 17h2"/> <path d="M20 7h2"/> <path d="M7 20v2"/> <path d="M7 2v2"/> <rect x="4" y="4" width="16" height="16" rx="2"/> <rect x="8" y="8" width="8" height="8" rx="1"/></svg></span>
+          <span class="mc-trend is-ok" id="mc-hv-vcpu-pct">{{ vcpu_pct|default:0 }}%</span>
+        </div>
+        <div class="mc-stat-num" id="mc-hv-vcpu-used">{{ stats.vcpus_used|default:0|intcomma }}</div>
+        <div class="mc-stat-label">{% trans "vCPUs" %} / <span id="mc-hv-vcpu-total">{{ stats.vcpus|default:0|intcomma }}</span></div>
+      </div>
+      <div class="mc-stat mc-stat--key">
+        <div class="mc-stat-top">
+          <span class="mc-stat-ic mc-ic-3"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 12v-2"/> <path d="M12 18v-2"/> <path d="M16 12v-2"/> <path d="M16 18v-2"/> <path d="M2 11h1.5"/> <path d="M20 18v-2"/> <path d="M20.5 11H22"/> <path d="M4 18v-2"/> <path d="M8 12v-2"/> <path d="M8 18v-2"/> <rect x="2" y="6" width="20" height="10" rx="2"/></svg></span>
+          <span class="mc-trend is-ok" id="mc-hv-ram-pct">{{ ram_pct|default:0 }}%</span>
+        </div>
+        <div class="mc-stat-num" id="mc-hv-ram-used">{{ stats.memory_mb_used|default:0|mb_float_format }}</div>
+        <div class="mc-stat-label">{% trans "RAM" %} / <span id="mc-hv-ram-total">{{ stats.memory_mb|default:0|mb_float_format }}</span></div>
+      </div>
+      <div class="mc-stat mc-stat--key">
+        <div class="mc-stat-top">
+          <span class="mc-stat-ic mc-ic-4"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="5" rx="9" ry="3"/> <path d="M3 5V19A9 3 0 0 0 21 19V5"/> <path d="M3 12A9 3 0 0 0 21 12"/></svg></span>
+          <span class="mc-trend is-ok">{% trans "live" %}</span>
+        </div>
+        <div class="mc-stat-num">{{ stats.running_vms|default:0|intcomma }}</div>
+        <div class="mc-stat-label">{% trans "Running instances" %}</div>
+      </div>
+    </div>
+  </div>
+
+  <div class="mc-hv-tabs-shell">
+    {{ tab_group.render }}
+  </div>
+
+  {% comment %} Physical totals drive Hypervisor/Compute Host; Placement capacity drives Resource Provider. {% endcomment %}
+  <script type="text/javascript">{% verbatim %}
+  window.MC_HV_PHYS = {% endverbatim %}{"vu":{{ stats.vcpus_used|default:0 }},"vt":{{ stats.vcpus|default:0 }},"mu":{{ stats.memory_mb_used|default:0 }},"mt":{{ stats.memory_mb|default:0 }}}{% verbatim %};
+  window.MC_HV_PROV = [{% endverbatim %}{% for p in providers %}{"n":"{{ p.name|escapejs }}","vu":{{ p.vcpus_used|default:0 }},"vt":{{ p.vcpus|default:0 }},"vc":{{ p.vcpus_capacity|default:0 }},"mu":{{ p.memory_mb_used|default:0 }},"mt":{{ p.memory_mb|default:0 }},"mc":{{ p.memory_mb_capacity|default:0 }}}{% if not forloop.last %},{% endif %}{% endfor %}{% verbatim %}];
+  (function(){
+    var prov = window.MC_HV_PROV || [];
+    var physical = window.MC_HV_PHYS || {};
+
+    /* ---- tổng overcommit cho 2 card ---- */
+    var vu=0, vc=0, mu=0, mc=0, i;
+    for (i=0;i<prov.length;i++){
+      vu += +prov[i].vu||0; vc += +prov[i].vc||0;
+      mu += +prov[i].mu||0; mc += +prov[i].mc||0;
+    }
+    function fmtInt(n){ return Math.round(n).toLocaleString('en-US'); }
+    function fmtMB(mb){
+      if(!mb) return '0';
+      var g = mb/1024;
+      if(g >= 1024){ return (g/1024).toFixed(1).replace(/\.0$/,'')+'TB'; }
+      if(g >= 100){ return Math.round(g)+'GB'; }
+      return g.toFixed(1).replace(/\.0$/,'')+'GB';
+    }
+    function pct(a,b){ return b>0 ? Math.round(a/b*100) : 0; }
+    function setText(id,t){ var el=document.getElementById(id); if(el) el.textContent=t; }
+
+    function renderCapacity(data){
+      if (+data.vt>0){
+        setText('mc-hv-vcpu-used', fmtInt(+data.vu||0));
+        setText('mc-hv-vcpu-total', fmtInt(+data.vt||0));
+        setText('mc-hv-vcpu-pct', pct(+data.vu||0,+data.vt||0)+'%');
+      }
+      if (+data.mt>0){
+        setText('mc-hv-ram-used', fmtMB(+data.mu||0));
+        setText('mc-hv-ram-total', fmtMB(+data.mt||0));
+        setText('mc-hv-ram-pct', pct(+data.mu||0,+data.mt||0)+'%');
+      }
+    }
+
+    function syncCapacity(){
+      var active = document.querySelector('.mc-hv-tabs-shell .nav-tabs li.active a');
+      var target = active ? (active.getAttribute('data-target') || active.getAttribute('href') || '') : '';
+      var useOvercommit = target.indexOf('__provider') !== -1;
+      renderCapacity(useOvercommit && vc>0 && mc>0 ?
+        {vu:vu,vt:vc,mu:mu,mt:mc} : physical);
+    }
+
+    window.MC_HV_SYNC_CAPACITY = syncCapacity;
+    document.addEventListener('click', function(event){
+      var tab = event.target.closest && event.target.closest('.mc-hv-tabs-shell .nav-tabs a[data-toggle="tab"]');
+      if (tab) setTimeout(syncCapacity, 0);
+    });
+    if (window.jQuery) {
+      window.jQuery(document).on('shown.bs.tab', '.mc-hv-tabs-shell .nav-tabs a[data-toggle="tab"]', syncCapacity);
+    }
+    syncCapacity();
+  })();
+  {% endverbatim %}</script>
+{% endblock %}
diff --git a/openstack_dashboard/themes/mycloud/templates/auth/_login.html b/openstack_dashboard/themes/mycloud/templates/auth/_login.html
new file mode 100644
index 000000000..b0a23ecff
--- /dev/null
+++ b/openstack_dashboard/themes/mycloud/templates/auth/_login.html
@@ -0,0 +1,304 @@
+{% load i18n static %}
+{% if 'is_modal' in request.GET or 'is_modal' in request.POST %}
+  {% include 'auth/_login_modal.html' %}
+{% else %}
+{# MyCloud / FTEL custom login — self-contained card, real Keystone form. #}
+<style>
+  .mc-login-bg{--mc-login-primary:#2563eb;--mc-login-on-primary:#fff;--mc-login-error:#dc2626;--mc-login-error-container:#fee2e2;--mc-login-on-error-container:#991b1b;--mc-login-surface:#fff;--mc-login-surface-dim:#e7edf5;--mc-login-surface-low:#f8fafc;--mc-login-input-bg:#f8fafc;--mc-login-input-text:#0f172a;--mc-login-placeholder:#94a3b8;--mc-login-on-surface:#0f172a;--mc-login-on-surface-variant:#64748b;--mc-login-outline:#cbd5e1;--mc-login-outline-variant:#e2e8f0;--mc-login-shadow:15,23,42;--mc-login-radius-lg:16px;--mc-login-radius-xl:24px;--mc-login-radius-xxl:28px;--mc-login-radius-full:999px;--mc-login-elevation-1:0 1px 2px rgba(var(--mc-login-shadow),.08),0 1px 3px rgba(var(--mc-login-shadow),.06);--mc-login-elevation-2:0 3px 8px rgba(var(--mc-login-shadow),.10),0 1px 3px rgba(var(--mc-login-shadow),.08);--mc-login-elevation-4:0 18px 48px rgba(var(--mc-login-shadow),.18),0 8px 20px rgba(var(--mc-login-shadow),.10);--mc-login-state-hover:rgba(37,99,235,.08);--mc-login-state-focus:rgba(37,99,235,.14);position:fixed;inset:0;z-index:10;overflow:auto;display:flex;align-items:center;justify-content:center;padding:40px 16px;
+    font-family:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;letter-spacing:-.006em;color:var(--mc-login-on-surface);background:radial-gradient(520px circle at 100% 0%,rgba(76,176,80,.14),transparent 68%),radial-gradient(900px circle at 14% 12%,rgba(37,99,235,.16),transparent 42%),radial-gradient(860px circle at 88% 82%,rgba(244,121,32,.10),transparent 46%),linear-gradient(160deg,#f8fafc 0%,#e8eef7 100%)}
+  .mc-login-bg *{box-sizing:border-box}
+  .mc-login-dots{position:absolute;inset:0;background-image:radial-gradient(rgba(15,23,42,.045) 1px,transparent 1px);background-size:28px 28px;-webkit-mask-image:linear-gradient(to bottom,rgba(0,0,0,.85),rgba(0,0,0,.35));mask-image:linear-gradient(to bottom,rgba(0,0,0,.85),rgba(0,0,0,.35));pointer-events:none}
+  .mc-login-col{position:relative;z-index:1;width:440px;max-width:calc(100vw - 32px);animation:mc-rise .24s cubic-bezier(.2,0,0,1)}
+  .mc-login-card{position:relative;background:rgba(255,255,255,.94);border:1px solid rgba(203,213,225,.72);border-radius:var(--mc-login-radius-xxl);box-shadow:var(--mc-login-elevation-4);overflow:hidden;backdrop-filter:blur(16px)}
+  .mc-login-card:before{content:"";position:absolute;inset:0 0 auto;height:5px;background:linear-gradient(90deg,#005bab 0 33.333%,#f47920 33.333% 66.666%,#4cb050 66.666% 100%)}
