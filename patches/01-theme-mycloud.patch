diff --git a/openstack_dashboard/themes/mycloud/templates/horizon/common/_az_limit_summary.html b/openstack_dashboard/themes/mycloud/templates/horizon/common/_az_limit_summary.html
new file mode 100644
index 000000000..1dc74e98b
--- /dev/null
+++ b/openstack_dashboard/themes/mycloud/templates/horizon/common/_az_limit_summary.html
@@ -0,0 +1,72 @@
+{% comment %}
+  MyCloud v2 - Usage by Availability Zone panel.
+  Metrics shown per AZ match the demo: vCPU, RAM and Storage.
+{% endcomment %}
+{% load i18n horizon %}
+
+{% spaceless %}
+  {% if az_usage_enabled %}
+    <div class="quota-dynamic az-limit-summary">
+      <div class="mc-panel">
+        <div class="mc-panel-head">
+          <div>
+            <h2 class="mc-panel-title">{% trans "Usage by Availability Zone" %}</h2>
+          </div>
+          <a href="{% url 'horizon:project:instances:index' %}" class="btn btn-default btn-sm mc-btn-ghost">{% trans "Details" %}</a>
+        </div>
+        <div class="mc-panel-body">
+          {% if az_charts %}
+            <div class="mc-az-grid">
+              {% for az in az_charts %}
+                {% with comp=az.charts.0 %}
+                  {% quotapercent comp.charts.1.used comp.charts.1.quota as pv %}
+                  {% quotapercent comp.charts.2.used comp.charts.2.quota as pr %}
+
+                  <div class="mc-az-card">
+                    <div class="mc-az-h">
+                      <div class="mc-az-name-inline">
+                        <span class="mc-az-dot {% if pv >= 90 or pr >= 90 %}is-danger{% elif pv >= 75 or pr >= 75 %}is-warn{% else %}is-ok{% endif %}"></span>
+                        {{ az.zone }}
+                      </div>
+                      <span class="mc-az-badge {% if pv >= 90 or pr >= 90 %}mc-az-badge--danger{% elif pv >= 75 or pr >= 75 %}mc-az-badge--warn{% else %}mc-az-badge--ok{% endif %}">
+                        {% if pv >= 90 or pr >= 90 %}{% trans "Full" %}{% elif pv >= 75 or pr >= 75 %}{% trans "Busy" %}{% else %}{% trans "Healthy" %}{% endif %}
+                      </span>
+                    </div>
+
+                    {% for section in az.charts %}
+                      {% for chart in section.charts %}
+                        {% if chart.type == 'cores' or chart.type == 'ram' or chart.type == 'gigabytes' %}
+                          {% quotapercent chart.used chart.quota as pct %}
+                          <div class="mc-meter-row">
+                            <div class="ml">
+                              <span class="mc-meter-name">
+                                {% if chart.type == 'cores' %}{% trans "vCPU" %}{% elif chart.type == 'ram' %}{% trans "RAM" %}{% elif chart.type == 'gigabytes' %}{% trans "Storage" %}{% else %}{{ chart.name }}{% endif %}
+                              </span>
+                              <span class="mc-meter-val">
+                                {% if chart.type == 'gigabytes' %}
+                                  {% if chart.quota|quotainf != '-1' %}{{ chart.used|floatformat:0 }} / {{ chart.quota|floatformat:0 }} GB{% else %}{{ chart.used|floatformat:0 }} GB{% endif %}
+                                {% else %}
+                                  {% if chart.quota|quotainf != '-1' %}{{ chart.used_display }} / {{ chart.quota_display }}{% else %}{{ chart.used_display }}{% endif %}
+                                {% endif %}
+                              </span>
+                            </div>
+                            <div class="mc-meter">
+                              <i class="{% if pct >= 90 %}is-danger{% elif pct >= 75 %}is-warn{% else %}is-ok{% endif %}"
+                                 style="transform:scaleX({{ pct }}e-2)"></i>
+                            </div>
+                          </div>
+                        {% endif %}
+                      {% endfor %}
+                    {% endfor %}
+                  </div>
+                {% endwith %}
+              {% endfor %}
+            </div>
+          {% else %}
+            <p class="alert alert-info mc-az-empty">{% trans "No availability zone usage data found for this project." %}</p>
+          {% endif %}
+        </div>
+      </div>
+    </div>
+  {% endif %}
+{% endspaceless %}
diff --git a/openstack_dashboard/themes/mycloud/templates/horizon/common/_limit_summary.html b/openstack_dashboard/themes/mycloud/templates/horizon/common/_limit_summary.html
new file mode 100644
index 000000000..88ba1f544
--- /dev/null
+++ b/openstack_dashboard/themes/mycloud/templates/horizon/common/_limit_summary.html
@@ -0,0 +1,67 @@
+{% comment %}
+  MyCloud — Overview KPI stat cards (single row), matching
+  horizon_redesign_interactive_v2.html: Instances · vCPUs · RAM · Storage.
+  Compute = charts[0] (Instances, vCPUs, RAM); Volume = charts[1]
+  (4th card uses the gigabytes/"Storage" chart, not the volume count).
+  Icons are inline stroke SVG (no emoji) — coloured via .mc-ic-N.
+{% endcomment %}
+{% load i18n horizon %}
+
+{% spaceless %}
+<div class="quota-dynamic limit-summary mc-key-stats">
+  {% for section in charts %}
+    {% if forloop.first %}
+      {# Compute: Instances (0), vCPUs (1), RAM (2) #}
+      {% for chart in section.charts %}
+        {% if forloop.counter <= 3 %}
+          {% quotapercent chart.used chart.quota as pct %}
+          <div class="mc-stat mc-stat--key">
+            <div class="mc-stat-top">
+              <span class="mc-stat-ic mc-ic-{{ forloop.counter }}">
+                {% if forloop.counter == 1 %}
+                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"/> <rect width="20" height="8" x="2" y="14" rx="2" ry="2"/> <line x1="6" x2="6.01" y1="6" y2="6"/> <line x1="6" x2="6.01" y1="18" y2="18"/></svg>
+                {% elif forloop.counter == 2 %}
+                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20v2"/> <path d="M12 2v2"/> <path d="M17 20v2"/> <path d="M17 2v2"/> <path d="M2 12h2"/> <path d="M2 17h2"/> <path d="M2 7h2"/> <path d="M20 12h2"/> <path d="M20 17h2"/> <path d="M20 7h2"/> <path d="M7 20v2"/> <path d="M7 2v2"/> <rect x="4" y="4" width="16" height="16" rx="2"/> <rect x="8" y="8" width="8" height="8" rx="1"/></svg>
+                {% else %}
+                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 12v-2"/> <path d="M12 18v-2"/> <path d="M16 12v-2"/> <path d="M16 18v-2"/> <path d="M2 11h1.5"/> <path d="M20 18v-2"/> <path d="M20.5 11H22"/> <path d="M4 18v-2"/> <path d="M8 12v-2"/> <path d="M8 18v-2"/> <rect x="2" y="6" width="20" height="10" rx="2"/></svg>
+                {% endif %}
+              </span>
+              {% if chart.quota|quotainf != '-1' %}
+                <span class="mc-trend {% if pct >= 90 %}is-danger{% elif pct >= 75 %}is-warn{% else %}is-ok{% endif %}">{{ pct }}% {% trans "quota" %}</span>
+              {% else %}
+                <span class="mc-trend mc-trend--nolimit">{% trans "No limit" %}</span>
+              {% endif %}
+            </div>
+            <div class="mc-stat-num">{{ chart.used_display }}</div>
+            <div class="mc-stat-label">
+              {% if chart.type == "ram" %}{% trans "RAM" %}{% else %}{{ chart.name }}{% endif %}{% if chart.quota|quotainf != '-1' %} / {{ chart.quota_display }}{% endif %}
+            </div>
+          </div>
+        {% endif %}
+      {% endfor %}
+    {% endif %}
+    {% if forloop.counter == 2 %}
+      {# Volume: 4th card = Storage (gigabytes), charts.2 #}
+      {% with chart=section.charts.2 %}
+        {% quotapercent chart.used chart.quota as pct %}
+        <div class="mc-stat mc-stat--key">
+          <div class="mc-stat-top">
+            <span class="mc-stat-ic mc-ic-4">
+              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/> <path d="M3 5V19A9 3 0 0 0 21 19V5"/> <path d="M3 12A9 3 0 0 0 21 12"/></svg>
+            </span>
+            {% if chart.quota|quotainf != '-1' %}
+              <span class="mc-trend {% if pct >= 90 %}is-danger{% elif pct >= 75 %}is-warn{% else %}is-ok{% endif %}">{{ pct }}% {% trans "quota" %}</span>
+            {% else %}
+              <span class="mc-trend mc-trend--nolimit">{% trans "No limit" %}</span>
+            {% endif %}
+          </div>
+          <div class="mc-stat-num">{{ chart.used_display }}</div>
+          <div class="mc-stat-label">
+            {% trans "Storage" %}{% if chart.quota|quotainf != '-1' %} / {{ chart.quota_display }}{% endif %}
+          </div>
+        </div>
+      {% endwith %}
+    {% endif %}
+  {% endfor %}
+</div>
+{% endspaceless %}
diff --git a/openstack_dashboard/themes/mycloud/templates/horizon/common/_quota_summary.html b/openstack_dashboard/themes/mycloud/templates/horizon/common/_quota_summary.html
new file mode 100644
index 000000000..da4236664
--- /dev/null
+++ b/openstack_dashboard/themes/mycloud/templates/horizon/common/_quota_summary.html
@@ -0,0 +1,55 @@
+{% comment %}
+  MyCloud v2 - Limit Summary panel.
+  Render Horizon quota sections as 3-column usage rows:
+  name | meter | used/limit.
+{% endcomment %}
+{% load i18n horizon %}
+
+{% spaceless %}
+<div class="quota-dynamic mc-quota-summary-wrap">
+  <div class="mc-panel">
+    <div class="mc-panel-head">
+      <div>
+        <h2 class="mc-panel-title">{% trans "Limit Summary" %}</h2>
+      </div>
+    </div>
+    <div class="mc-panel-body">
+      <div class="mc-quota-summary">
+        {% for section in charts %}
+          {% if section.charts %}
+            <div class="mc-quota-group">
+              <div class="mc-quota-head">{{ section.title }}</div>
+              {% for chart in section.charts %}
+                {% quotapercent chart.used chart.quota as pct %}
+                <div class="mc-quota-row">
+                  <span class="mc-quota-name" title="{{ chart.name }}">
+                    {% if chart.type == "ram" %}
+                      {% trans "RAM (GB)" %}
+                    {% elif chart.type == "gigabytes" %}
+                      {% trans "Storage (GB)" %}
+                    {% elif chart.type == "security_group_rule" %}
+                      {% trans "SG Rules" %}
+                    {% else %}
+                      {{ chart.name }}
+                    {% endif %}
+                  </span>
+                  <div class="mc-meter">
+                    <i class="{% if pct >= 90 %}is-danger{% elif pct >= 75 %}is-warn{% else %}is-ok{% endif %}" style="transform:scaleX({{ pct }}e-2)"></i>
+                  </div>
+                  <span class="mc-quota-val">
+                    {% if chart.type == "gigabytes" %}
+                      {{ chart.used|floatformat:0 }}{% if chart.quota|quotainf != '-1' %} <span class="mc-quota-den">/ {{ chart.quota|floatformat:0 }} GB</span>{% else %} GB{% endif %}
+                    {% else %}
+                      {{ chart.used_display }}{% if chart.quota|quotainf != '-1' %} <span class="mc-quota-den">/ {{ chart.quota_display }}</span>{% endif %}
+                    {% endif %}
+                  </span>
+                </div>
+              {% endfor %}
+            </div>
+          {% endif %}
+        {% endfor %}
+      </div>
+    </div>
+  </div>
+</div>
+{% endspaceless %}
diff --git a/openstack_dashboard/themes/mycloud/templates/horizon/common/_sidebar.html b/openstack_dashboard/themes/mycloud/templates/horizon/common/_sidebar.html
new file mode 100644
index 000000000..dbb852072
--- /dev/null
+++ b/openstack_dashboard/themes/mycloud/templates/horizon/common/_sidebar.html
@@ -0,0 +1,1611 @@
+{% load branding horizon i18n %}
+
+<nav id="sidebar">
+  {% comment %}
+    Preload the two Inter subsets every page actually uses (latin + vietnamese)
+    so the font downloads in parallel with CSS instead of after first layout —
+    less FOUT. href must byte-match the FIRST url() in the @font-face src below,
+    and crossorigin is required (font fetches are CORS-mode) or the browser
+    fetches the file twice.
+  {% endcomment %}
+  <link rel="preload" href="{{ WEBROOT }}static/themes/mycloud/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
+  <link rel="preload" href="{{ WEBROOT }}static/themes/mycloud/fonts/inter-vietnamese.woff2" as="font" type="font/woff2" crossorigin>
+  <style>
+    /* Self-hosted Inter + JetBrains Mono (variable woff2, bundled in the theme)
+       so the modern font works fully offline (Kolla / air-gapped). Declared in
+       the inline style — always template-rendered & never offline-compressed —
+       so the font loads even if the compiled CSS is stale. */
