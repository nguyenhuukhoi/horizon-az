+
+// =====================================================================
+//  Buttons
+// =====================================================================
+.btn {
+  border-radius: 8px;
+  font-weight: 600;
+  padding-left: 14px;
+  padding-right: 14px;
+  transition: background .12s ease, box-shadow .12s ease, border-color .12s ease;
+  // Centre the icon with the label on EVERY button (not just table actions).
+  // Flex drops the whitespace between an icon <span> and the label, so gap
+  // gives consistent spacing without double-spacing where markup had a space.
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 7px;
+}
+.btn-block { display: flex; }
+// Angular <action> buttons wrap the icon+label in <ng-transclude>, which would
+// keep the icon on the text baseline (off-centre). Let it pass through so the
+// icon and label become the button's own flex items and centre properly.
+.btn > ng-transclude,
+.btn > [ng-transclude] { display: contents; }
+// The generic .btn rules above must not break two .btn special-cases:
+// 1) the responsive nav toggle — keep it hidden on desktop (inline-flex above
+//    would otherwise override Bootstrap's display:none).
+@media (min-width: 768px) { .navbar-toggle { display: none; } }
+// 2) the themable <select> toggle — value on the left, caret on the right
+//    (justify-content:center above would otherwise centre them).
+.themable-select > .btn { width: 100%; justify-content: space-between; }
+// Django server-filter row ("Field = | input | Filter"): the themable-select
+// toggle and the Filter submit button keep Bootstrap's ~38px height because the
+// .table_actions height rule doesn't always reach them. Force the 34px toolbar
+// height directly on both so they line up with every other action button.
+.table_search .themable-select > .btn,
+.table_search > .btn,
+.table_search button[type="submit"] { height: 36px !important; min-height: 36px !important; max-height: 36px !important; }
+// Split buttons: the inline-flex .btn above sizes each button to its content,
+// so a caret-only toggle ends up shorter than its text sibling. Make the group
+// flex with stretch so both buttons share the tallest height.
+.btn-group:not(.btn-group-vertical) { display: inline-flex; align-items: stretch; vertical-align: middle; }
+
+// Row-level action buttons (inside td.actions_column): match toolbar height.
+td.actions_column .btn,
+form.actions_column .btn {
+  height: 36px !important;
+  min-height: 36px !important;
+  padding-left: 14px !important;
+  padding-right: 14px !important;
+}
+
+// Icon span with no resolved class renders as phantom space — hide it
+.btn .fa-undefined { display: none !important; }
+
+// Bootstrap's .btn-sm defaults to 3px radius — override to match theme 8px
+.btn-sm {
+  border-radius: 8px !important;
+}
+
+.btn-primary {
+  box-shadow: 0 1px 2px rgba(37, 99, 235, .25);
+}
+
+.btn-default {
+  background: #fff;
+  border-color: #cbd5e1;
+  color: #334155;
+
+  // Pin the text colour on hover/focus too. Horizon gives some buttons BOTH
+  // .btn-default and .btn-primary (e.g. the console-log "Go" submit); without
+  // this, Bootstrap's `.btn-primary:hover { color:#fff }` leaks through and the
+  // label turns white on the light hover background — effectively invisible.
+  &:hover,
+  &:focus {
+    background: #f1f5f9;
+    border-color: #94a3b8;
+    color: #334155;
+  }
+}
+
+// =====================================================================
+//  Forms
+// =====================================================================
+.form-control {
+  border-radius: 8px;
+  border-color: #cbd5e1;
+  box-shadow: none;
+  padding-left: 14px;
+  padding-right: 14px;
+
+  &:focus {
+    border-color: $brand-primary;
+    box-shadow: 0 0 0 3px rgba(37, 99, 235, .15);
+  }
+}
+
+.input-group-addon {
+  padding-left: 14px;
+  padding-right: 14px;
+}
+
+// =====================================================================
+//  Labels / badges (status chips)
+// =====================================================================
+.label {
+  border-radius: 20px;
+  padding: .3em .7em;
+  font-weight: 600;
+  font-size: 85%;
+}
+
+.badge {
+  border-radius: 20px;
+  font-weight: 600;
+}
+
+// =====================================================================
+//  Pagination / breadcrumbs / alerts
+// =====================================================================
+.pagination > li > a,
+.pagination > li > span {
+  border-color: $mc-border;
+}
+
+// Breadcrumb (Project / Compute / Instances) — match mockup .mc-page-crumb
+.page-breadcrumb { margin: 0; }
+.breadcrumb {
+  background: transparent;
+  border-radius: 0;
+  margin: 0 0 8px;
+  padding: 0;
+  font-size: 14px;
+  line-height: 1.4;
+  color: #94a3b8;
+
+  > li + li::before { content: "/"; color: #cbd5e1; padding: 0 7px; }
+  a { color: #64748b; font-weight: 600; }
+  a:hover { color: $brand-primary; }
+  > .active { color: #94a3b8; }
+}
+
+.alert {
+  border-radius: 10px;
+  border: 1px solid transparent;
+}
+
+// =====================================================================
+//  Page header
+// =====================================================================
+// Page header — match mockup .mc-page-head (compact, no border, title 22px,
+// actions pushed right). Applies to every standard Horizon page.
+.page-header {
+  margin: 0 0 20px;
+  padding: 0;
+  border-bottom: 0;
+  min-height: 0;
+  display: flex;
+  align-items: flex-end;
+  justify-content: space-between;
+  gap: 16px;
+  flex-wrap: wrap;
+
+  // AngularJS routed detail pages (Images, etc.) render a plain .page-header
+  // holding a Back breadcrumb + a Bootstrap .row (col-sm-9 title + col-sm-3
+  // actions). The flex above shrinks that .row to content width and shoves it
+  // right, collapsing the actions column so Launch + dropdown wrap. Any
+  // .page-header that holds a .row must stay block so the grid lays out.
+  &:has(> .row) { display: block; }
+
+  .details-item-actions .btn-group {
+    display: inline-flex;
+    flex-wrap: nowrap;
+    vertical-align: middle;
+
+    > .btn { float: none; }
+  }
+
+  // Detail pages use Horizon's original Bootstrap grid: title col-sm-9 on the
+  // left and actions col-sm-3 on the right. Only the split-button internals are
+  // forced not to wrap.
+  &.detail-header {
+    display: block;
+
+    > .row {
+      display: block;
+      margin-left: -15px;
+      margin-right: -15px;
+
+      &::before,
+      &::after {
+        content: " ";
+        display: table;
+      }
+
+      &::after {
+        clear: both;
+      }
+    }
+
+    .detail-title {
+      float: left;
+      min-width: 0;
+      width: 75%;
+      padding-left: 15px;
+      padding-right: 15px;
+      text-align: left;
+
+      .h1 {
+        display: block;
+        text-align: left;
+      }
+    }
+
+    .detail-actions {
+      float: right;
+      min-width: 0;
+      width: 25%;
+      margin-left: 0;
+      padding-left: 15px;
+      padding-right: 15px;
+      display: block;
+      text-align: right;
+    }
+
+    .detail-actions-form {
+      display: inline-flex;
+      justify-content: flex-end;
+      margin: 0;
+    }
+
+    .detail-actions .btn-group {
+      display: inline-flex;
+      align-items: stretch;
+      flex-wrap: nowrap;
+      vertical-align: middle;
+
+      > .btn {
+        float: none;
+        display: inline-flex;
+        align-items: center;
+        justify-content: center;
+      }
+    }
+
+    @media (max-width: 767px) {
+      .detail-title,
+      .detail-actions {
+        float: none;
+        width: 100%;
+      }
+
+      .detail-actions {
+        margin-top: 12px;
+        text-align: left;
+      }
+    }
+  }
+
+  h1 {
+    flex: 1 1 auto;
+    min-width: 0;
+    font-size: 22px;
+    font-weight: 700;
+    line-height: 1.2;
+    margin: 0;
+    color: $text-color;
+  }
+
+  h2 { font-weight: 700; }
+
+  // action buttons that live in the header (e.g. some panels)
+  .actions_column,
+  form.actions_column {
+    margin: 0;
+    float: none;
+    flex: 0 0 auto;
+    max-width: 100%;
+    display: inline-flex;
+    align-items: center;
+    justify-content: flex-end;
+    gap: 8px;
+    white-space: nowrap;
+
+    .btn-group {
+      display: inline-flex;
+      align-items: stretch;
+      flex-wrap: nowrap;
+      vertical-align: middle;
+
+      > .btn {
+        float: none;
+        display: inline-flex;
+        align-items: center;
+        justify-content: center;
+      }
+    }
+  }
+}
+
+// =====================================================================
+//  Overview — stat cards + AZ panel (replaces d3 pie charts in this theme)
+//  Markup from theme template overrides _limit_summary / _az_limit_summary
+//  Matches horizon_redesign_mockup.html
+// =====================================================================
+.mc-usage {
+  margin-bottom: $mc-section-gap;
+
+  .mc-section-title {
+    font-size: 22px;
+    font-weight: 700;
+    color: $text-color;
+    margin: 6px 0 16px;
+  }
+
+  // "Compute" / "Volume" / "Network" group labels
+  .mc-group-title {
+    font-size: 12px;
+    font-weight: 700;
+    text-transform: uppercase;
+    letter-spacing: .5px;
+    color: #64748b;
+    margin: 22px 0 12px;
+  }
+}
+
+// ---- Stat cards (Limit Summary) ----
+.quota-dynamic.az-limit-summary,
+.quota-dynamic.mc-quota-summary-wrap {
+  padding-bottom: 0;
+  margin-bottom: 0;
+}
+
+.quota-dynamic.mc-key-stats {
+  overflow: visible;
+  padding-bottom: 4px;
+  margin-bottom: 12px;
+}
+
+.mc-stat-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
+  gap: 16px;
+}
+
+.mc-stat {
+  background: $mc-surface;
+  border: 1px solid $mc-border;
+  border-radius: 12px;
+  box-shadow: $mc-shadow;
+  padding: 16px 18px;
+  min-height: 148px;
+  display: flex;
+  flex-direction: column;
+  transition: none;
+  animation: none;
+  transform: none;
+
+  &:hover,
+  &:focus,
+  &:active {
+    border-color: $mc-border;
+    box-shadow: $mc-shadow;
+    transform: none;
+  }
+
+  .mc-stat-top {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+  }
+
+  .mc-stat-ic {
+    width: 42px;
+    height: 42px;
+    border-radius: 12px;
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+
+    svg { width: 22px; height: 22px; }
+
+    // colour variants cycle per section
+    &.mc-ic-1 { background: #dbeafe; color: #2563eb; }
+    &.mc-ic-2 { background: #ccfbf1; color: #0d9488; }
+    &.mc-ic-3 { background: #ede9fe; color: #7c3aed; }
+    &.mc-ic-4,
+    &.mc-ic-5,
+    &.mc-ic-6 { background: #fef3c7; color: #d97706; }
+  }
+
+  .mc-trend {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    min-height: 24px;
+    white-space: nowrap;
+    font-size: 12px;
+    font-weight: 700;
+    padding: 3px 10px;
+    border-radius: 20px;
+    background: #f1f5f9;
+    color: #64748b;
+
+    &.is-ok     { background: #dcfce7; color: #16a34a; }
+    &.is-warn   { background: #fef3c7; color: #d97706; }
+    &.is-danger { background: #fee2e2; color: #dc2626; }
+    &.mc-trend--nolimit { background: #f1f5f9; color: #94a3b8; font-weight: 600; }
+  }
+
+  .mc-stat-num {
+    font-size: 28px;
+    font-weight: 700;
+    line-height: 1;
+    letter-spacing: 0;
+    color: $text-color;
+    margin-top: 20px;
+  }
+
+  .mc-stat-label {
+    font-size: 14px;
+    font-weight: 600;
+    color: #64748b;
+    margin-top: 8px;
+    line-height: 1.35;
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+  }
+
+  .mc-stat-sub {
+    font-size: 12px;
+    color: #94a3b8;
+    margin-top: 2px;
+  }
+}
+
+// ---- AZ panel ----
+.mc-panel {
+  margin-bottom: $mc-section-gap;
+  background: $mc-surface;
+  border: 1px solid $mc-border;
+  border-radius: 12px;
+  box-shadow: $mc-shadow;
+  overflow: hidden;
+
+  .mc-panel-head {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    padding: 14px 18px;
+    border-bottom: 1px solid $mc-border;
+  }
+
+  .mc-panel-title {
+    font-size: 16px;
+    font-weight: 700;
+    margin: 0;
+    color: $text-color;
+  }
+
+  .mc-panel-sub {
+    font-size: 12px;
+    color: #94a3b8;
+    margin-top: 2px;
+  }
+
+  .mc-panel-body { padding: 18px; }
+}
+
+.mc-az-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 16px;
+}
+
+@media (max-width: 900px) {
+  .mc-az-grid {
+    grid-template-columns: 1fr;
+  }
+}
+
+.mc-az-card {
+  border: 1px solid $mc-border;
+  border-radius: 12px;
+  padding: 16px 16px 18px;
+
+  .mc-az-h {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    margin-bottom: 12px;
+  }
+
+  .mc-az-name-inline {
+    display: flex;
+    align-items: center;
+    gap: 8px;
+    font-weight: 700;
+    font-size: 14px;
+    color: $text-color;
+  }
+
+  .mc-az-dot {
+    width: 9px;
+    height: 9px;
+    border-radius: 50%;
+    flex-shrink: 0;
+    background: $brand-primary;
+
+    &.is-ok     { background: #16a34a; }
+    &.is-warn   { background: $brand-warning; }
+    &.is-danger { background: $brand-danger; }
+  }
+
+  .mc-az-badge {
+    font-size: 12px;
+    font-weight: 700;
+    padding: 2px 10px;
+    border-radius: 20px;
+
+    &.mc-az-badge--ok     { background: #dcfce7; color: #16a34a; }
+    &.mc-az-badge--warn   { background: #fef3c7; color: #d97706; }
+    &.mc-az-badge--danger { background: #fee2e2; color: #dc2626; }
+  }
+
+  .mc-az-group {
+    font-size: 11px;
+    font-weight: 700;
+    text-transform: uppercase;
+    letter-spacing: .5px;
+    color: #94a3b8;
+    margin: 12px 0 8px;
+  }
+}
+
+.mc-meter-row {
+  margin: 9px 0;
+
+  .ml {
+    display: flex;
+    justify-content: space-between;
+    font-size: 14px;
+    margin-bottom: 5px;
+    gap: 8px;
+  }
+
+  .mc-meter-name {
+    color: #334155;
+    font-weight: 500;
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+  }
+
+  .mc-meter-val { color: #94a3b8; white-space: nowrap; }
+}
+
+// shared meter bar (AZ rows)
+.mc-meter {
+  height: 7px;
+  background: #eef2f6;
+  border-radius: 20px;
+  overflow: hidden;
+
+  > i {
+    display: block;
+    height: 100%;
+    width: 100%;
+    border-radius: 20px;
+    transform-origin: left center;
+    transition: transform .4s ease;
+
+    &.is-ok     { background: $brand-primary; }
+    &.is-warn   { background: $brand-warning; }
+    &.is-danger { background: $brand-danger; }
+  }
