+// Launch Instance → brand blue + server (instance) icon, matching the
+// active "Instances" item in the sidebar.
+.btn-launch,
+a.btn-launch {
+  background: $brand-primary !important;
+  border-color: $brand-primary !important;
+  color: #fff !important;
+  box-shadow: $mc-shadow-sm;
+
+  &:hover,
+  &:focus,
+  &:active {
+    background: darken($brand-primary, 6%) !important;
+    color: #fff !important;
+  }
+
+  // Launch button icon: SVG via CSS mask (no Font Awesome glyph)
+  .fa {
+    display: inline-block;
+    width: 14px;
+    height: 14px;
+    &::before {
+      content: "";
+      display: block;
+      width: 100%;
+      height: 100%;
+      background-color: currentColor;
+      -webkit-mask: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.9' stroke-linecap='round' stroke-linejoin='round'><rect width='20' height='8' x='2' y='2' rx='2' ry='2'/><rect width='20' height='8' x='2' y='14' rx='2' ry='2'/><line x1='6' x2='6.01' y1='6' y2='6'/><line x1='6' x2='6.01' y1='18' y2='18'/></svg>") center/contain no-repeat;
+      mask: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.9' stroke-linecap='round' stroke-linejoin='round'><rect width='20' height='8' x='2' y='2' rx='2' ry='2'/><rect width='20' height='8' x='2' y='14' rx='2' ry='2'/><line x1='6' x2='6.01' y1='6' y2='6'/><line x1='6' x2='6.01' y1='18' y2='18'/></svg>") center/contain no-repeat;
+    }
+  }
+}
+
+// Primary Create/Allocate/Import buttons -> brand blue (class added by JS),
+// matching the mockup. Delete stays red, Launch keeps its own blue.
+.mc-create-btn,
+a.mc-create-btn,
+button.mc-create-btn {
+  background: $brand-primary !important;
+  border-color: $brand-primary !important;
+  color: #fff !important;
+  box-shadow: 0 1px 2px rgba(37, 99, 235, .25);
+
+  &:hover,
+  &:focus {
+    background: darken($brand-primary, 6%) !important;
+    border-color: darken($brand-primary, 6%) !important;
+    color: #fff !important;
+  }
+}
+
+// Pre-colour the create button on first paint (fa-plus = Horizon's native
+// create glyph) so it doesn't flash white before JS adds .mc-create-btn.
+#content_body .hz-dynamic-table-actions .btn:has(.fa-plus),
+#content_body .table_actions .btn:has(.fa-plus) {
+  background: $brand-primary;
+  border-color: $brand-primary;
+  color: #fff;
+}
+
+// Semantic SVG icon injected into Create / toolbar buttons (by JS in _sidebar)
+.mc-act-ic {
+  width: 14px;
+  height: 14px;
+  min-width: 14px;
+  max-width: 14px;
+  min-height: 14px;
+  max-height: 14px;
+  flex: 0 0 14px;
+}
+
+// user-menu dropdown icons + required-field marker (SVG, no Font Awesome)
+.mc-menu-ic {
+  width: 16px;
+  height: 16px;
+  min-width: 16px;
+  max-width: 16px;
+  min-height: 16px;
+  max-height: 16px;
+  vertical-align: -3px;
+  margin-right: 8px;
+}
+.mc-req-ic { width: 8px; height: 8px; vertical-align: 1px; }
+
+// Horizon has a high-specificity (0,6,4) rule that sets 'transparent' on the
+// data row immediately following a .detail-row (expanded content row):
+//   .table-rsp.table-detail.table-striped tbody tr.detail-row:nth-child(4n+2) + tr:not(.spacer-row) td
+// This overrides our general white rule (0,4,3), making every 2nd+ data row
+// transparent. Beat it with an ID-anchored rule (1,7,4) that covers all normal
+// data rows (not selected, not warning, not detail/spacer rows).
+#content_body hz-resource-table .table-rsp.table-detail.table-striped > tbody > tr:not(.st-selected):not(.warning):not(.detail-row):not(.spacer-row) > td {
+  background-color: #fff;
+}
+
+// Also cover .warning rows (transiently added by ng-class during data-load).
+#content_body hz-resource-table .table.table-striped > tbody > tr.warning > td {
+  background-color: #fff;
+}
+
+// Angular dynamic-table toolbar (magic-search pages e.g. Images): keep the
+// magic-search bar, just align the action buttons to the 38px row.
+#content_body hz-resource-table,
+#content_body hz-dynamic-table,
+#content_body hz-magic-search-context,
+#content_body .hz-magic-search-context {
+  display: block;
+  width: 100%;
+  max-width: 100%;
+  flex-shrink: 0; // never let the table column shrink during Angular cold-load
+}
+
+// Magic-search pages (Images, Key Pairs, Server Groups, Load Balancers): the
+// search bar floats flat above the white table card, with a gap between them.
+// The context itself is just a transparent container.
+#content_body hz-resource-table .hz-magic-search-context {
+  background: transparent;
+  border: 0;
+  border-radius: 0;
+  box-shadow: none;
+  margin-bottom: 0;
+  overflow: visible;
+}
+
+// Search bar floats flat above the table (native-Horizon look): transparent,
+// no panel/border, just a gap separating it from the white table card below.
+#content_body hz-resource-table .hz-magic-search-context > .row {
+  background: transparent;
+  border: 0;
+  border-radius: 0;
+  margin: 0 0 $mc-section-gap 0;
+  padding: 0;
+}
+
+// Table = its own white card. border-collapse: separate lets the rounded
+// corners render; overflow stays visible so row-action dropdowns aren't clipped.
+#content_body hz-resource-table .hz-magic-search-context > table {
+  background: $mc-surface;
+  border: 1px solid $mc-border;
+  border-radius: 12px;
+  box-shadow: $mc-shadow;
+  border-collapse: separate;
+  border-spacing: 0;
+}
+
+#content_body .hz-magic-search-context > .row {
+  margin-left: 0;
+  margin-right: 0;
+}
+
+#content_body .hz-dynamic-table-preamble {
+  display: flex !important;
+  align-items: center;
+  gap: 10px;
+  width: 100%;
+  min-width: 0;
+  // col-xs-12 padding offset the zeroed .row margin and pushed the toolbar
+  // 15px right of the table; drop it so the toolbar aligns with the table.
+  padding-left: 0;
+  padding-right: 0;
+}
+// Same fix for transfer tables inside non-wizard modals (Manage Members,
+// Modify Quotas, …): zeroed .row margin + leftover col padding pushed the
+// search toolbar 15px right of the list.
+.modal .hz-dynamic-table-preamble { padding-left: 0; padding-right: 0; }
+#content_body .hz-magic-search-bar { padding-right: 0 !important; flex: 1 1 auto; min-width: 0; }
+#content_body .hz-dynamic-table-actions { display: inline-flex; align-items: center; gap: 10px; flex: 0 0 auto; }
+// neutralise Horizon's per-action padding so every gap is exactly 10px
+#content_body .hz-dynamic-table-actions action-list { padding-left: 0 !important; }
+#content_body .hz-dynamic-table-actions .btn { height: 36px; padding: 0 14px; border-radius: 8px; display: inline-flex; align-items: center; gap: 7px; white-space: nowrap; }
+// Cold-load: batch actions render ~1-2s after the magic-search bar, so the bar
+// briefly spans the whole row and "swallows" the buttons. Fade the toolbar in
+// only once the buttons exist (1.8s fallback for tables without batch actions).
+@keyframes mc-toolbar-reveal { to { opacity: 1; } }
+#content_body .hz-dynamic-table-preamble { animation: mc-toolbar-reveal .01s linear 1.8s forwards; }
+#content_body .hz-dynamic-table-preamble:not(:has(.hz-dynamic-table-actions .btn)) { opacity: 0; }
+#content_body .hz-dynamic-table-preamble:has(.hz-dynamic-table-actions .btn) { opacity: 1; animation: none; transition: opacity .2s ease; }
+#content_body .hz-magic-search-context > table,
+#content_body .hz-magic-search-context table.table {
+  width: 100%;
+  min-width: 100%;
+}
+// Reserve the row-actions column so the late-rendering Launch/row buttons don't
+// make the data columns expand-then-shrink on cold load ("teo nhỏ"). The header
+// th (last, empty = actions column) holds the width even before any rows render.
+#content_body .hz-magic-search-context td.actions_column,
+#content_body .hz-magic-search-context thead th:last-child:empty { min-width: 150px; }
+// Shimmering skeleton in the reserved space while Angular builds the row
+// buttons, so the cell doesn't look like a missing button. Gone once a .btn
+// renders in that cell.
+@keyframes mc-skel { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }
+#content_body .hz-magic-search-context td.actions_column:not(:has(.btn)) { text-align: right; }
+#content_body .hz-magic-search-context td.actions_column:not(:has(.btn))::after {
+  content: ""; display: inline-block; width: 92px; height: 30px; border-radius: 8px;
+  vertical-align: middle;
+  background: linear-gradient(90deg, #eef2f7 25%, #e2e8f0 50%, #eef2f7 75%);
+  background-size: 200% 100%; animation: mc-skel 1.2s ease-in-out infinite;
+}
+@media (prefers-reduced-motion: reduce) {
+  #content_body .hz-magic-search-context td.actions_column:not(:has(.btn))::after,
+  body.mc-ngdetail .page-header > .row > .details-item-actions:not(:has(.btn))::after {
+    animation: none;
+  }
+}
+
+@media (min-width: 900px) {
+  #content_body .hz-magic-search-context table.table-rsp {
+    .rsp-p1,
+    .rsp-p2,
+    .rsp-p3,
+    .rsp-p4 {
+      display: table-cell !important;
+    }
+
+    .rsp-alt-p1,
+    .rsp-alt-p2,
+    .rsp-alt-p3,
+    .rsp-alt-p4 {
+      display: none !important;
+    }
+  }
+}
+
+// Clamp the magic-search bar to the same 38px row as the buttons.
+// Use min-height too in case the theme's $input-height-base is taller.
+#content_body .hz-magic-search-bar {
+  .magic-search-bar { margin: 0 !important; }
+  .magic-search-bar,
+  .input-group,
+  .input-group-addon,
+  .input-group-btn,
+  .input-group-btn > button,
+  .form-control,
+  .magic-search,
+  .search-bar { height: 40px !important; min-height: 40px !important; max-height: 40px !important; }
+  // round the outer ends only (handles both with/without the settings cog)
+  .input-group > :first-child { border-radius: 8px 0 0 8px; }
+  .input-group > :last-child { border-radius: 0 8px 8px 0; }
+  .form-control,
+  .magic-search,
+  .search-bar { display: flex; align-items: center; }
+  // let the input grow to full width so the placeholder isn't clipped
+  .form-control,
+  .magic-search,
+  .search-bar,
