+
+// ---- Limit Summary panel (quota bar rows) ----
+.mc-quota-summary-wrap {
+  margin-bottom: 0;
+}
+
+.mc-quota-summary {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
+  gap: 14px;
+  align-items: stretch;
+}
+
+.mc-quota-group {
