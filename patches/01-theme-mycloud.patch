+
+/* Django detail header -> flex so the injected "Back to list" button sits
+   between the title and the actions (like Angular routed-detail). Declared after
+   the float rules above so it overrides them (same specificity, later wins). */
+.page-header.detail-header{display:flex !important;flex-wrap:wrap;align-items:center;gap:10px}
+.page-header.detail-header > .row{display:contents !important}
+.page-header.detail-header .detail-title{order:1 !important;flex:1 1 auto !important;float:none !important;width:auto !important;padding:0 !important}
+.page-header.detail-header .detail-actions{order:3 !important;float:none !important;width:auto !important;padding:0 !important;display:inline-flex !important;align-items:center}
