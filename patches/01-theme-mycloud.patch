+        code: code === 13 ? 'Enter' : '',
+        keyCode: code,
+        which: code
+      });
+      try {
+        Object.defineProperty(ev, 'keyCode', { get: function () { return code; } });
+        Object.defineProperty(ev, 'which', { get: function () { return code; } });
+      } catch (ignore) {}
+    } catch (ignore) {
+      ev = document.createEvent('Event');
+      ev.initEvent(type, true, true);
+      ev.keyCode = code;
+      ev.which = code;
+    }
+    return ev;
+  }
