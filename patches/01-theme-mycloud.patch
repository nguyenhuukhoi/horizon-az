+
+// Horizon adds has-feedback to the input's immediate wrapper, not always the
+// outer form-group. Anchor the toggle to that wrapper so both password eyes
+// sit at the exact vertical centre of their 40px MD3 fields.
+.modal .has-feedback > .form-control-feedback.password-icon,
+.ng-wizard .has-feedback > .form-control-feedback.password-icon {
+  display: inline-flex !important;
+  align-items: center;
+  justify-content: center;
+  top: 0 !important;
+  right: 0 !important;
+  width: 40px !important;
+  height: 40px !important;
+  margin: 0 !important;
+  line-height: 1 !important;
+}
+
+.modal .has-feedback > .form-control-feedback.password-icon::before,
+.ng-wizard .has-feedback > .form-control-feedback.password-icon::before {
+  width: 18px !important;
+  height: 18px !important;
+  flex: 0 0 18px;
+}
+
+// The generic icon mask uses a 1em box. Validation feedback instead needs
+// Bootstrap's full control-height box so the 14px glyph remains centred in
+// the input rather than sitting against its top-right edge.
+.modal .form-group.has-feedback > .form-control-feedback.fa-check,
+.modal .form-group.has-feedback > .form-control-feedback.fa-times,
+.ng-wizard .form-group.has-feedback > .form-control-feedback.fa-check,
+.ng-wizard .form-group.has-feedback > .form-control-feedback.fa-times {
+  display: inline-flex !important;
+  align-items: center;
+  justify-content: center;
+  width: 34px !important;
+  height: 34px !important;
+  line-height: 34px !important;
+  font-size: 14px !important;
+  vertical-align: middle;
+}
+
+.modal .form-group.has-feedback > .form-control-feedback.fa-check::before,
+.modal .form-group.has-feedback > .form-control-feedback.fa-times::before,
+.ng-wizard .form-group.has-feedback > .form-control-feedback.fa-check::before,
+.ng-wizard .form-group.has-feedback > .form-control-feedback.fa-times::before {
+  width: 14px !important;
+  height: 14px !important;
+}
