+// =====================================================================
+//  Modals & Launch Instance wizard (Angular ng-wizard)
+// =====================================================================
+.modal-content {
+  border-radius: 12px;  // match the card radius across the theme
+  box-shadow: 0 24px 60px rgba(15, 23, 42, .25);
+}
+.modal-header { border-bottom: 1px solid $mc-border; }
+.modal-footer {
+  border-top: 1px solid $mc-border;
+  background: #f8fafc;
+  border-bottom-left-radius: 12px;
+  border-bottom-right-radius: 12px;
+}
+
+body.modal-open {
+  overflow: hidden !important;
+}
+
+// Keep long Angular modal-forms and classic Django workflows inside the
+// viewport. Header/footer remain fixed while only the form body scrolls.
+// Launch Instance owns its sizing through .modal-dialog-wizard below; loading
+// dialogs also keep their native geometry.
+@media (min-width: 768px) {
+  .modal:not(.loading):not(.modal-wait-spinner):not(.modal-dialog-wizard) .modal-dialog {
+    margin-top: 24px;
+    margin-bottom: 24px;
+  }
+
+  .modal:not(.loading):not(.modal-wait-spinner):not(.modal-dialog-wizard) .modal-content {
+    display: flex;
+    flex-direction: column;
+    max-height: calc(100vh - 48px);
+    overflow: hidden;
+  }
+
+  .modal:not(.loading):not(.modal-wait-spinner):not(.modal-dialog-wizard)
+    .modal-content > .modal-header,
+  .modal:not(.loading):not(.modal-wait-spinner):not(.modal-dialog-wizard)
+    .modal-content > .modal-footer {
+    flex: 0 0 auto;
+  }
+
+  .modal:not(.loading):not(.modal-wait-spinner):not(.modal-dialog-wizard)
+    .modal-content > .modal-body {
+    flex: 1 1 auto;
+    min-height: 0;
+    overflow-x: hidden;
+    overflow-y: auto;
+    overscroll-behavior: contain;
+    scrollbar-gutter: stable;
+  }
+
+  // Django ModalFormView places body/footer inside a form. Make that wrapper
+  // participate in the same fixed-header/footer flex layout.
+  .modal:not(.loading):not(.modal-wait-spinner):not(.modal-dialog-wizard)
+    .modal-content > form {
+    display: flex;
+    flex: 1 1 auto;
+    flex-direction: column;
+    min-height: 0;
+    overflow: hidden;
+  }
+
+  .modal:not(.loading):not(.modal-wait-spinner):not(.modal-dialog-wizard)
+    .modal-content > form > .modal-body {
+    flex: 1 1 auto;
+    min-height: 0;
+    overflow-x: hidden;
+    overflow-y: auto;
+    overscroll-behavior: contain;
+    scrollbar-gutter: stable;
+  }
+
+  .modal:not(.loading):not(.modal-wait-spinner):not(.modal-dialog-wizard)
+    .modal-content > form > .modal-footer {
+    flex: 0 0 auto;
+  }
+}
+
+// Create Application Credential has a long explanatory column. Keep the
+// modal itself stable and let only that help column scroll on desktop.
+@media (min-width: 768px) {
+  .modal .mc-app-credential-form .modal-body > .row {
+    display: flex;
+    align-items: stretch;
+  }
+
+  .modal .mc-app-credential-form .mc-app-credential-help {
+    max-height: calc(100vh - 250px);
+    overflow-x: hidden;
+    overflow-y: auto;
+    overscroll-behavior: contain;
+    padding-right: 12px;
+    scrollbar-gutter: stable;
+  }
+}
+
+// MD3 modal scrim: keep the dialog sharp while softening the page beneath it.
+// The translucent color remains a usable fallback when backdrop-filter is absent.
+.modal-backdrop {
+  background-color: rgba(15, 23, 42, .46) !important;
+  -webkit-backdrop-filter: blur(6px);
+  backdrop-filter: blur(6px);
+}
+
+.modal-backdrop.in,
+.modal-backdrop.show {
+  opacity: 1 !important;
+}
+
+body.mc-spinner-modal-open .modal-backdrop {
+  -webkit-backdrop-filter: none;
+  backdrop-filter: none;
+}
+
+// Loading dialogs only need horizontal centring. Preserve Horizon's vertical
+// placement and the Bootstrap mobile edge gutter.
+@media (min-width: 768px) {
+  .modal.loading .modal-dialog,
+  .modal.modal-wait-spinner .modal-dialog {
+    margin-left: auto !important;
+    margin-right: auto !important;
+  }
+}
+
+.modal-dialog-wizard .modal-dialog,
+.modal-dialog.modal-dialog-wizard {
+  margin-top: 36px;
+  margin-bottom: 36px;
+}
+
+// ── MD3 Dialog title — Title Large: 22sp / 28sp / weight 400 / tracking 0 ──
+.modal .modal-header .modal-title,
+.modal .modal-header .h4 {
+  font-size: 22px;
+  line-height: 28px;
+  font-weight: 400;
+  letter-spacing: 0;
+}
+
+// ── MD3 Modal footer buttons — shared by Django + Angular wizard ──────────
+// Scoped to modal footer only; does NOT affect table action / toolbar buttons.
+.modal .modal-footer .btn,
+.workflow.static_page .modal-footer .btn {
+  height: 36px;
+  min-height: 36px;
+  padding: 0 14px;
+  border-radius: 9999px;  // MD3 button shape = corner-full (pill)
+  font-size: 14px;        // Label Large
+  font-weight: 500;       // Label Large weight (MD3 spec)
+  line-height: 20px;
+  letter-spacing: 0.1px;  // MD3 label-large tracking
+
+  &[disabled],
+  &.disabled {
+    opacity: 0.38;         // MD3 disabled state
+    pointer-events: none;
+    box-shadow: none;
+  }
+}
+
+// Angular wizard Cancel: outlined pill matching the established MyCloud
+// secondary-action treatment. The X icon is injected by decorateCancel().
+.ng-wizard .modal-footer .btn.pull-left {
+  height: 36px !important;
+  min-height: 36px !important;
+  padding: 0 14px !important;
+  gap: 8px;
+  background: #fff !important;
+  border: 1px solid #cbd5e1 !important;
+  border-radius: 9999px !important;
+  color: #334155 !important;
+  box-shadow: none !important;
+
+  &:hover,
+  &:focus {
+    background: #f8fafc !important;
+    border-color: #94a3b8 !important;
+    color: #0f172a !important;
+  }
+}
+
+// Keep the native Angular spinner while submitting; at rest, render the same
+// server glyph used by the Instances entry in the MyCloud sidebar.
+.ng-wizard .modal-footer .btn.finish .fa:not(.fa-spinner)::before {
+  content: "";
+  display: block;
+  width: 100%;
+  height: 100%;
+  background-color: currentColor;
+  -webkit-mask: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.9' stroke-linecap='round' stroke-linejoin='round'><rect width='20' height='8' x='2' y='2' rx='2' ry='2'/><rect width='20' height='8' x='2' y='14' rx='2' ry='2'/><line x1='6' x2='6.01' y1='6' y2='6'/><line x1='6' x2='6.01' y1='18' y2='18'/></svg>") center/contain no-repeat;
+  mask: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='1.9' stroke-linecap='round' stroke-linejoin='round'><rect width='20' height='8' x='2' y='2' rx='2' ry='2'/><rect width='20' height='8' x='2' y='14' rx='2' ry='2'/><line x1='6' x2='6.01' y1='6' y2='6'/><line x1='6' x2='6.01' y1='18' y2='18'/></svg>") center/contain no-repeat;
+}
+
+// Angular wizard: Back / Next → MD3 outlined button (transparent fill, border)
+.ng-wizard .modal-footer .btn.back,
+.ng-wizard .modal-footer .btn.next {
+  background: transparent;
+  border: 1px solid #cbd5e1;
+  color: #334155;
+
+  &:hover,
+  &:focus { background: #f1f5f9; border-color: #94a3b8; }
+}
+
+// Angular wizard: Finish → MD3 filled button (keeps existing $brand-primary)
+.ng-wizard .modal-footer .btn.finish {
+  padding: 0 14px;
+}
+
+.ng-wizard {
+  .wizard-navigation { background: #f8fafc; }
+
+  // The modal body scrolls as one unit; the step content is often taller than
+  // the step list, so pin the left nav column so the steps stay visible instead
+  // of scrolling away with the content.
+  .modal-body > .row > .col-sm-3 {
+    position: sticky;
+    top: 0;
+    z-index: 2;
+    background: $mc-surface;
+  }
+
+  // step list — MD3 Label Large: 14px / weight 500 / 20px line-height / 0.1px tracking
+  .nav-pills > li > a {
+    border-radius: 999px;
+    color: #64748b;
+    font-size: 14px;
+    font-weight: 500;
+    line-height: 20px;
+    letter-spacing: 0.1px;
+  }
+  .nav-pills > li.active > a,
+  .nav-pills > li.active > a:hover,
+  .nav-pills > li.active > a:focus {
+    background: $brand-primary;
+    border-color: transparent;
+    border-radius: 999px;
+    color: #fff;
+    outline: 0;
+  }
+
+  // transfer table (available / allocated)
+  .transfer-available .panel-heading,
+  .transfer-allocated .panel-heading {
+    font-weight: 700;
+    background: #f8fafc;
+  }
+
+  .transfer-table {
+    .transfer-section {
+      margin-top: 12px;
+    }
+
+    .transfer-heading {
+      display: block;
+      margin: 0 0 8px;
+      font-size: 20px;
+      line-height: 1.3;
+      font-weight: 600;
+
+      .fa {
+        margin-right: 6px;
+      }
+
+      .badge {
+        vertical-align: 2px;
+      }
+
+      .help-text {
+        margin-top: 6px;
+        margin-right: 6px;
+        font-size: 13px;
+        line-height: 1.4;
+        font-weight: 500;
+        color: #94a3b8;
+      }
+    }
+
+    .magic-search-bar,
+    .basic-search-bar {
+      margin: 6px 0 8px;
+    }
+
+    .hz-dynamic-table-preamble {
+      padding-left: 0;
+      padding-right: 0;
+    }
+
+    .hz-magic-search-bar {
+      padding-right: 0;
+    }
+
+    .table {
+      margin-bottom: 8px;
+    }
+  }
+}
+
+// Make .modal-content the containing block for the fixed help toggle above, so
+// it anchors to the modal (header) rather than the viewport. `contain: layout`
+// does this without a transform (no text blur) and only kicks in for modals
+// that actually have a help toggle. The sticky wizard step-nav lives inside the
+// scrolling .modal-body and is unaffected.
+.modal-content:has(.help-toggle) {
+  contain: layout;
+}
+
+// Wizard "?" help toggle — clean circular ghost button instead of the
+// heavy default. MD3 groups header icon buttons at the trailing edge, so pin it
+// into the modal header just left of the close (X) instead of floating in the
+// content's top-right corner. The button lives inside the scrollable
+// .modal-body, so `position: fixed` + a containing block on .modal-content (the
+// `contain: layout` rule below) lets it escape the body's overflow/scroll and
+// stay anchored to the header. Offsets are measured from the modal edges, so
+// they hold across modal sizes. Same button in the launch wizard and plain
+// form modals (Create Key Pair, etc. render help-panel in .modal-body).
+.ng-wizard .help-toggle,
+.modal .help-toggle {
+  position: fixed;
+  top: 9px;
+  right: 61px;
+  margin: 0;
+  width: 30px;
+  height: 30px;
+  padding: 0;
+  line-height: 1;
+  border-radius: 50%;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  font-size: 14px;
+  background: #fff;
+  border: 1px solid $mc-border;
+  color: #64748b;
+  box-shadow: $mc-shadow-sm;
+
+  &:hover,
+  &:focus,
+  &:active {
+    background: #f1f5f9;
+    color: $text-color;
+    box-shadow: $mc-shadow-sm;
+  }
+}
+
+// Font Awesome glyphs -> SVG via CSS mask (theme-wide; pure CSS, no JS, so it
+// never touches the Angular digest). Animated fa-spinner is left as-is.
+.help-toggle .fa,
+.fa-close, .fa-times, .fa-angle-left, .fa-angle-right, .fa-angle-up, .fa-angle-down,
+.fa-chevron-left, .fa-chevron-right, .fa-chevron-up, .fa-chevron-down,
+.fa-caret-down, .fa-caret-up, .fa-check, .fa-asterisk, .fa-bars, .fa-plus,
+.fa-trash, .fa-trash-o, .fa-question-circle, .fa-search, .fa-info-circle, .fa-cog,
+.fa-cloud-download, .fa-eye, .fa-eye-slash {
+  display: inline-block; width: 1em; height: 1em; line-height: 1; vertical-align: -0.125em;
+}
+.fa-asterisk { width: 1em; height: 1em; color: #dc2626 !important; }
+.help-toggle .fa::before,
+.fa-close::before, .fa-times::before, .fa-angle-left::before, .fa-angle-right::before,
+.fa-angle-up::before, .fa-angle-down::before, .fa-chevron-left::before, .fa-chevron-right::before,
+.fa-chevron-up::before, .fa-chevron-down::before, .fa-caret-down::before, .fa-caret-up::before,
+.fa-check::before, .fa-asterisk::before, .fa-bars::before, .fa-plus::before, .fa-trash::before,
+.fa-trash-o::before, .fa-question-circle::before, .fa-search::before, .fa-info-circle::before, .fa-cog::before,
+.fa-cloud-download::before, .fa-eye::before, .fa-eye-slash::before {
+  content: ""; display: block; width: 100%; height: 100%; background-color: currentColor;
+}
