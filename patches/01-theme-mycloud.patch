+// =====================================================================
+//  MD3 typography + dense data-table rhythm
+// =====================================================================
+:root {
+  --mc-type-page-size: 22px;
+  --mc-type-page-line: 28px;
+  --mc-type-title-size: 16px;
+  --mc-type-title-line: 24px;
+  --mc-type-body-size: 14px;
+  --mc-type-body-line: 20px;
+  --mc-type-label-size: 12px;
+  --mc-type-label-line: 16px;
+  --mc-type-caption-size: 11px;
+  --mc-type-caption-line: 16px;
+  --mc-type-metric-size: 28px;
+  --mc-type-metric-line: 36px;
+  --mc-table-edge-space: 10px;
+}
+
+body {
+  font-size: var(--mc-type-body-size);
+  line-height: var(--mc-type-body-line);
+}
+
+#content_body .page-header h1,
+#content_body .mc-page-title,
+#content_body h1 {
+  font-size: var(--mc-type-page-size);
+  font-weight: 700;
+  line-height: var(--mc-type-page-line);
+  letter-spacing: 0;
+}
+
+#content_body .breadcrumb,
+#content_body .mc-page-crumb {
+  font-size: var(--mc-type-label-size);
+  line-height: var(--mc-type-label-line);
+  letter-spacing: 0;
+}
+
+#content_body .panel-title,
+#content_body .mc-panel-title,
+#content_body .mc-recent-title,
+#content_body .mc-usage-table-title,
+#content_body .mc-hv-table-title,
+#content_body .mc-instance-card h4,
+#content_body .detail h3,
+#content_body .detail h4 {
+  font-size: var(--mc-type-title-size);
+  line-height: var(--mc-type-title-line);
+  letter-spacing: 0;
+}
+
+#content_body .form-control,
+#content_body label,
+#content_body .btn,
+#sidebar a.openstack-panel,
+#sidebar .openstack-panel-group > a {
+  font-size: var(--mc-type-body-size);
+  line-height: var(--mc-type-body-line);
+  letter-spacing: 0;
+}
+
+#sidebar .openstack-dashboard > a {
+  font-size: var(--mc-type-caption-size);
+  line-height: var(--mc-type-caption-line);
+  letter-spacing: 0;
+}
+
+#content_body .mc-stat-num {
+  font-size: var(--mc-type-metric-size);
+  line-height: var(--mc-type-metric-line);
+}
+
+#content_body .mc-stat-label,
+#content_body .mc-az-row,
+#content_body .mc-quota-name,
+#content_body .mc-hv-tabs-shell .nav-tabs > li > a,
+#content_body .mc-hv-filter input {
+  font-size: var(--mc-type-body-size);
+  line-height: var(--mc-type-body-line);
+}
+
+#content_body .table {
+  width: 100%;
+  table-layout: auto;
+  font-size: var(--mc-type-body-size);
+  line-height: var(--mc-type-body-line);
+}
+
+#content_body .table > thead > tr > th {
+  padding: 10px;
+  font-size: var(--mc-type-label-size);
+  line-height: var(--mc-type-label-line);
+  letter-spacing: 0;
+  white-space: nowrap;
+}
+
+// 10px horizontal cell padding (was 12px) keeps column-heavy tables (Instances,
+// Volumes) within the card so the rounded corners + shadow frame them uniformly
+// instead of the table spilling past the right edge.
+#content_body .table > tbody > tr > td,
+#content_body .table > tbody > tr > th {
+  padding: 12px 10px;
+  font-size: var(--mc-type-body-size);
+  line-height: var(--mc-type-body-line);
+}
+
+// Instance Console Log — present the raw <pre> as a theme card (soft surface,
+// hairline border, 12px radius, soft shadow) instead of the default grey <pre>.
+// Content and its scroll behaviour are untouched; long lines scroll sideways.
+#content_body pre.logs {
+  margin: 12px 0 0;
+  padding: 16px 18px;
+  background: #f8fafc;
+  color: $text-color;
+  border: 1px solid $mc-border;
+  border-radius: 12px;
+  box-shadow: $mc-shadow;
+  font-size: 13px;
+  line-height: 1.55;
+  overflow-x: auto;
+}
+
+// "Log Length" control row — the field ships as a bare Bootstrap-2 `span1`
+// input (sharp, native border, mis-sized), so it clashes with the pill buttons
+// beside it. Bring it onto the theme's input language: 32px tall to sit level
+// with the row, 8px radius, hairline border and the brand focus ring.
+#content_body #tail_length label {
+  vertical-align: middle;
+  margin-right: 6px;
+  font-weight: 600;
+  color: $text-color;
+}
+
+#content_body #tail_length input[type="text"] {
+  height: 32px;
+  width: 90px;
+  margin: 0 8px;
+  padding: 0 12px;
+  vertical-align: middle;
+  border: 1px solid #cbd5e1;
+  border-radius: 8px;
+  background: #fff;
+  box-shadow: none;
+  font-size: 14px;
+  line-height: 30px;
+  color: $text-color;
+}
+
+#content_body #tail_length input[type="text"]:focus {
+  outline: 0;
+  border-color: $brand-primary;
+  box-shadow: 0 0 0 3px rgba($brand-primary, .14);
+}
+
+// Instance Console tab — card the pane ONLY once it's loaded, i.e. once it
+// actually holds the #console_embed iframe. While Horizon AJAX-loads the tab
+// there's no iframe, so the pane stays plain and the "Loading…" spinner sits on
+// the page (like the Log tab) instead of inside an empty card. Once loaded the
+// console sits on a proper MyCloud card. The iframe height is bounded because
+// Horizon's fix_height script sets it to the whole document height (~950px+),
+// which would otherwise grow the page into a giant canvas.
+#instance_details__console:has(#console_embed) {
+  margin-top: 4px;
+  padding: 20px;
+  background: $mc-surface;
+  border: 1px solid $mc-border;
+  border-radius: 12px;
+  box-shadow: $mc-shadow;
+  box-sizing: border-box;
+}
+
+// The tab is already labelled "Log" / "Console", so the in-panel heading
+// ("Instance Console Log" / "Instance Console") is redundant — hide it.
+#instance_details__log h3,
+#instance_details__console > h3 {
+  display: none;
+}
+
+#instance_details__console > .alert {
+  margin: 0 0 16px;
+}
+
+#instance_details__console > #console_embed {
+  display: block;
+  width: 100% !important;
+  height: 600px !important;
+  background: #0f172a;
+  border: 1px solid $mc-border;
+  border-radius: 10px;
+  box-sizing: border-box;
+}
+
+// Fallback shown when the console can't load ("Unable to load console…").
+#instance_details__console > .well {
+  margin: 0;
+  padding: 18px;
+  background: #f8fafc;
+  border: 1px solid $mc-border;
+  border-radius: 10px;
+  box-shadow: none;
+}
+
+@media (max-width: 767px) {
+  #instance_details__console:has(#console_embed) {
+    padding: 12px;
+  }
+
+  #instance_details__console > #console_embed {
+    height: 460px !important;
+    border-radius: 8px;
+  }
+}
+
+#content_body .table_count,
+#content_body [hz-table-footer] td > span:first-child,
+#content_body .help-block,
+#content_body .mc-panel-subtitle,
+#content_body .mc-quota-value,
+#content_body .mc-hv-provider-meter .mc-hv-meter-line {
+  font-size: var(--mc-type-label-size);
+  line-height: var(--mc-type-label-line);
+  letter-spacing: 0;
+}
+
+#content_body .mc-stat-badge,
+#content_body .label,
+#content_body .badge {
+  font-size: var(--mc-type-label-size);
