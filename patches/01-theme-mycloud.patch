+body.mc-lbaas-page .col-md-6.detail{background:#fff;border:1px solid #e2e8f0;border-radius:12px;box-shadow:0 1px 2px rgba(15,23,42,.06),0 4px 12px rgba(15,23,42,.06);padding:16px 20px;margin:0 0 16px;float:none;width:100%;box-sizing:border-box}
+body.mc-lbaas-page .col-md-6.detail h4{margin:0 0 14px;padding-bottom:12px;border-bottom:1px solid #e2e8f0;font-size:16px;font-weight:700;color:#0f172a;line-height:1.25}
+
+// Transfer-table allocate/deallocate: the fa-arrow class sits on the <button>
+// itself (empty content), so the masked ::before collapses to 0. Centre it and
+// give the ::before a fixed size so the circle-plus / circle-minus shows.
+.fa-arrow-up, .fa-arrow-down,
+.mc-transfer-add, .mc-transfer-remove {
+  display: inline-flex !important; align-items: center; justify-content: center;
+  width: 36px !important; min-width: 36px !important; height: 36px !important; min-height: 36px !important; line-height: 0;
+  border: 0 !important; border-radius: 999px !important; cursor: pointer; color: #fff !important;
+  box-shadow: none !important; -webkit-appearance: none !important; appearance: none !important;
+  box-sizing: border-box; outline: 0 !important; padding: 0 !important; text-align: center;
+}
+.fa-arrow-up, .mc-transfer-add { background: #2563eb !important; }
+.fa-arrow-down, .mc-transfer-remove { background: #dc2626 !important; }
+.fa-arrow-up:hover, .mc-transfer-add:hover { background: #1d4ed8 !important; }
+.fa-arrow-down:hover, .mc-transfer-remove:hover { background: #b91c1c !important; }
+.fa-arrow-up:focus, .fa-arrow-down:focus, .fa-arrow-up:active, .fa-arrow-down:active,
+.mc-transfer-add:focus, .mc-transfer-remove:focus, .mc-transfer-add:active, .mc-transfer-remove:active {
+  box-shadow: none !important; outline: 0 !important;
+}
+.fa-arrow-up::before, .fa-arrow-down::before {
