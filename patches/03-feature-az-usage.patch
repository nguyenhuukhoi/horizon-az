+        self.assertEqual(2 * flavor.ram, self._chart(compute1, 'ram')['used'])
+        volume1 = self._section(az1, 'Volume')
+        self.assertEqual(1, self._chart(volume1, 'volumes')['used'])
+        self.assertEqual(10, self._chart(volume1, 'gigabytes')['used'])
+        self.assertEqual(1, self._chart(volume1, 'snapshots')['used'])
+
+        # az-2: 1 instance + a 30GB volume, no snapshot
+        compute2 = self._section(az2, 'Compute')
+        self.assertEqual(1, self._chart(compute2, 'instances')['used'])
+        volume2 = self._section(az2, 'Volume')
+        self.assertEqual(30, self._chart(volume2, 'gigabytes')['used'])
+        self.assertEqual(0, self._chart(volume2, 'snapshots')['used'])
+
+        # Denominator stays the project quota (shared across AZs).
+        self.assertEqual(res.context['usage'].limits['cores']['quota'],
