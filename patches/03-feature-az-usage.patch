+    @staticmethod
+    def _chart(section, chart_type):
+        return [c for c in section['charts'] if c['type'] == chart_type][0]
+
+    def test_az_usage(self):
+        flavor = self.flavors.first()
+        servers = [self._fake_server('az-1', flavor.id),
+                   self._fake_server('az-1', flavor.id),
+                   self._fake_server('az-2', flavor.id)]
+        volumes = [self._fake_volume('v1', 'az-1', 10),
+                   self._fake_volume('v2', 'az-2', 30)]
+        snapshots = [self._fake_snapshot('v1')]
+        self._stub_api_calls(az_servers=servers, az_volumes=volumes,
+                             az_snapshots=snapshots)
+
+        res = self.client.get(INDEX_URL)
+        self.assertTemplateUsed(res, 'horizon/common/_az_limit_summary.html')
+
+        self.assertTrue(res.context['az_usage_enabled'])
