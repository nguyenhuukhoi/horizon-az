+        az1, az2 = az_charts
+        # az-1: 2 instances of the same flavor + a 10GB volume + 1 snapshot
+        compute1 = self._section(az1, 'Compute')
+        self.assertEqual(2, self._chart(compute1, 'instances')['used'])
+        self.assertEqual(2 * flavor.vcpus,
